---
import PrototypeDisclaimer from '../components/PrototypeDisclaimer.astro';
const { title = 'Preview' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Prototype preview" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-neutral-50 text-neutral-900 antialiased">
    <slot />
    <PrototypeDisclaimer />
  </body>
</html>
