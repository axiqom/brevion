---
import PrototypeDisclaimer from '../components/PrototypeDisclaimer.astro';
import Header from '../components/Header';
import Footer from '../components/Footer.astro';
import BrevionChat from '../components/BrevionChat';
import { withBase } from '../lib/base';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  currentPage?: 'home' | 'capabilities' | 'industries' | 'work' | 'rfq';
}

const {
  title = 'Brevion — Advanced Precision Manufacturing',
  description = 'CNC machining for prototype and production. CNC milling, CNC turning, assembly, and inspection.',
  currentPage = 'home',
} = Astro.props;
---
<!doctype html>
<html lang="en" class="overflow-x-hidden">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <title>{title}</title>
    <link rel="icon" href={withBase('brand/raw/9.png')} type="image/png" />
    <link rel="apple-touch-icon" href={withBase('brand/raw/9.png')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Organization',
      name: 'Brevion',
      legalName: 'Brevion Systems',
      description,
      email: 'sales@brevion.com',
      url: 'https://axiqom.github.io/brevion/',
    })} />
  </head>
  <body class="flex min-h-screen flex-col overflow-x-hidden bg-porcelain text-carbon/75">
    <Header client:load currentPage={currentPage} />
    <main class="flex-grow">
      <slot />
    </main>
    <Footer />
    <BrevionChat client:load />
    <PrototypeDisclaimer />
  </body>
</html>
