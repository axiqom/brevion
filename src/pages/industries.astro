---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/base';
import ExpandableCardGrid from '../components/ExpandableCard';
import MidCta from '../components/sections/MidCta.astro';
import MobileConvertBar from '../components/MobileConvertBar';

const industries = [
  {
    id: 'aerospace',
    title: 'Aerospace',
    line: 'Flight hardware and structural components.',
    img: withBase('media/ind-aerospace.jpg'),
    alt: 'Jet engine turbine cutaway with precision machined blades',
    span: 'md:col-span-2',
    minHeightClass: 'min-h-[240px] sm:min-h-[300px] md:min-h-[380px]',
    objectClass: 'object-[center_40%]',
    facts: [
      'Tight-tolerance flight and structural parts.',
      'Metals used in airframe and engine work.',
      'Documentation when the program requires it.',
    ],
    rfqSlug: 'aerospace',
  },
  {
    id: 'defense',
    title: 'Defense',
    line: 'Controlled parts with traceability when specified.',
    img: withBase('media/ind-defense.jpg'),
    alt: 'F-35 fighter aircraft in a clean hangar',
    span: 'md:col-span-1',
    minHeightClass: 'min-h-[240px] sm:min-h-[300px] md:min-h-[380px]',
    facts: [
      'Machined components for defense programs.',
      'Traceability when the print calls for it.',
      'NDA and controlled-file handling available.',
    ],
    rfqSlug: 'defense',
  },
  {
    id: 'medical',
    title: 'Medical',
    line: 'Implant and instrument components.',
    img: withBase('media/ind-medical.jpg'),
    alt: 'Precision metal and polymer orthopedic implant components',
    span: 'md:col-span-1',
    minHeightClass: 'min-h-[240px] sm:min-h-[300px] md:min-h-[380px]',
    facts: [
      'Orthopedic and instrument components.',
      'Metals and medical-grade plastics.',
      'Surface and dimensional requirements per print.',
    ],
    rfqSlug: 'medical',
  },
  {
    id: 'robotics',
    title: 'Robotics',
    line: 'Structural and motion parts for automation.',
    img: withBase('media/ind-robotics.jpg'),
    alt: 'Industrial robotic arms assembling a vehicle chassis',
    span: 'md:col-span-2',
    minHeightClass: 'min-h-[240px] sm:min-h-[300px] md:min-h-[380px]',
    objectClass: 'object-[center_45%]',
    facts: [
      'Housings, brackets, and motion components.',
      'Prototype frames through production lots.',
      'Fits with assembly when needed.',
    ],
    rfqSlug: 'robotics',
  },
  {
    id: 'industrial',
    title: 'Industrial',
    line: 'Machine and equipment components.',
    img: withBase('media/ind-industrial.jpg'),
    alt: 'CNC machining center on a clean production floor',
    span: 'md:col-span-2',
    minHeightClass: 'min-h-[240px] sm:min-h-[300px] md:min-h-[380px]',
    facts: [
      'Fixtures, housings, and wear parts.',
      'Metals for industrial equipment.',
      'Prototype and production volumes.',
    ],
    rfqSlug: 'industrial',
  },
  {
    id: 'automotive',
    title: 'Automotive',
    line: 'Precision parts for vehicle systems.',
    span: 'md:col-span-1',
    minHeightClass: 'min-h-[240px] sm:min-h-[300px] md:min-h-[380px]',
    facts: [
      'Brackets, housings, and drivetrain-adjacent parts.',
      'Metals and engineering plastics.',
      'Prototype through production.',
    ],
    rfqSlug: 'automotive',
  },
  {
    id: 'energy',
    title: 'Energy',
    line: 'Components for energy systems.',
    img: withBase('media/ind-energy.jpg'),
    alt: 'Wind turbines across an open field at sunset',
    span: 'md:col-span-1',
    minHeightClass: 'min-h-[240px] sm:min-h-[300px] md:min-h-[380px]',
    objectClass: 'object-[center_55%]',
    facts: [
      'Structural and mechanical energy-system parts.',
      'Corrosion-resistant metals when specified.',
      'Documentation for field deployment when needed.',
    ],
    rfqSlug: 'energy',
  },
  {
    id: 'consumer',
    title: 'Consumer Products',
    line: 'Enclosures and precision product parts.',
    span: 'md:col-span-2',
    minHeightClass: 'min-h-[240px] sm:min-h-[300px] md:min-h-[380px]',
    facts: [
      'Enclosures, mechanisms, and finish-critical parts.',
      'Metals and engineering plastics.',
      'Low to mid volume production.',
    ],
    rfqSlug: 'consumer',
  },
];
---
<BaseLayout
  title="Industries — Brevion"
  description="CNC machining for aerospace, defense, medical, robotics, industrial, automotive, energy, and consumer products."
  currentPage="industries"
>
  <section class="border-b border-aluminum/35 bg-porcelain pt-24 pb-14 sm:pt-28 sm:pb-20 md:pt-36 md:pb-28">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <p class="mb-5 text-[11px] font-semibold uppercase tracking-[0.28em] text-aluminum sm:mb-6">
        Industries
      </p>
      <h1 class="max-w-3xl text-3xl font-bold uppercase leading-[0.96] tracking-tight text-carbon sm:text-4xl md:text-5xl lg:text-6xl xl:text-7xl">
        Industries We Serve
      </h1>
      <p class="mt-6 max-w-lg text-base font-medium leading-relaxed text-carbon/60 sm:mt-8 md:text-lg">
        Open a sector for typical part types and a quote path.
      </p>
    </div>
  </section>

  <section class="bg-porcelain pb-14 sm:pb-16 md:pb-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <ExpandableCardGrid
        client:load
        items={industries}
        columnsClass="grid grid-cols-1 gap-4 md:grid-cols-3 md:gap-5"
      />
    </div>
  </section>

  <MidCta line="Working in aerospace, medical, or robotics? Start a quote." />

  <section id="cta" class="border-t border-aluminum/35 bg-aluminum/10 py-20 sm:py-28 md:py-36">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col items-stretch justify-between gap-8 sm:items-start sm:gap-10 md:flex-row md:items-center">
        <h2 class="max-w-xl text-2xl font-bold uppercase tracking-tight text-carbon sm:text-3xl md:text-4xl lg:text-5xl">
          Ready to Start?
        </h2>
        <a href={withBase('rfq')} class="btn-primary min-h-12 w-full px-8 py-4 sm:min-h-11 sm:w-auto">
          Request a Quote
        </a>
      </div>
    </div>
  </section>
  <MobileConvertBar client:load />
</BaseLayout>
