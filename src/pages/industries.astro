---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/base';
import MobileConvertBar from '../components/MobileConvertBar';

type Industry = {
  name: string;
  img?: string;
  alt?: string;
  span: string;
};

const industries: Industry[] = [
  {
    name: 'Aerospace',
    img: withBase('media/ind-aerospace.jpg'),
    alt: 'Aircraft structure and precision aerospace hardware',
    span: 'md:col-span-2',
  },
  {
    name: 'Defense',
    img: withBase('media/ind-defense.jpg'),
    alt: 'Defense-grade precision machined components',
    span: 'md:col-span-1',
  },
  {
    name: 'Medical',
    img: withBase('media/ind-medical.jpg'),
    alt: 'Clean precision components for medical devices',
    span: 'md:col-span-1',
  },
  {
    name: 'Robotics',
    img: withBase('media/ind-robotics.jpg'),
    alt: 'Robotic arm and precision machined robotics parts',
    span: 'md:col-span-2',
  },
  {
    name: 'Industrial',
    img: withBase('media/ind-industrial.jpg'),
    alt: 'Industrial automation machinery and custom fixtures',
    span: 'md:col-span-2',
  },
  {
    name: 'Automotive',
    span: 'md:col-span-1',
  },
  {
    name: 'Energy',
    span: 'md:col-span-1',
  },
  {
    name: 'Consumer Products',
    span: 'md:col-span-2',
  },
];
---
<BaseLayout
  title="Industries — Brevion"
  description="CNC machining for aerospace, defense, medical, robotics, industrial, automotive, energy, and consumer products."
  currentPage="industries"
>
  <section class="border-b border-aluminum/40 bg-porcelain py-20 md:py-28">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <p class="mb-4 text-[11px] font-semibold uppercase tracking-[0.22em] text-aluminum">
        Industries
      </p>
      <h1 class="max-w-3xl text-4xl font-bold uppercase tracking-tight text-carbon md:text-5xl lg:text-6xl">
        Industries We Serve
      </h1>
    </div>
  </section>

  <section class="bg-porcelain pb-20 md:pb-28">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 gap-4 md:grid-cols-3 md:gap-5">
        {industries.map((ind) => (
          <div
            class={`group relative aspect-[4/3] min-h-[240px] overflow-hidden rounded-xl outline-none sm:min-h-[280px] md:aspect-auto md:min-h-[320px] md:rounded-2xl ${ind.img ? 'bg-carbon' : 'border border-aluminum/40 bg-aluminum/15'} ${ind.span}`}
          >
            {ind.img ? (
              <>
                <img
                  src={ind.img}
                  alt={ind.alt}
                  class="absolute inset-0 h-full w-full object-cover opacity-70 transition-[transform,opacity] duration-500 motion-reduce:transition-none group-hover:scale-[1.03] group-hover:opacity-85"
                  loading="lazy"
                  decoding="async"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-carbon/90 via-carbon/40 to-transparent" />
                <div class="absolute inset-0 flex flex-col justify-end p-6 sm:p-8 md:p-10">
                  <h2 class="text-xl font-bold uppercase tracking-tight text-porcelain sm:text-2xl md:text-3xl">
                    {ind.name}
                  </h2>
                </div>
              </>
            ) : (
              <div class="absolute inset-0 flex flex-col justify-end p-6 sm:p-8 md:p-10">
                <div class="mb-auto mt-6 h-px w-12 bg-aluminum" aria-hidden="true" />
                <h2 class="text-xl font-bold uppercase tracking-tight text-carbon sm:text-2xl md:text-3xl">
                  {ind.name}
                </h2>
              </div>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="cta" class="border-t border-aluminum/40 bg-aluminum/10 py-20 md:py-28">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col items-start justify-between gap-8 md:flex-row md:items-center">
        <h2 class="text-3xl font-bold uppercase tracking-tight text-carbon md:text-4xl">
          Ready to Start?
        </h2>
        <a href={withBase('rfq')} class="btn-primary px-8 py-4">
          Request a Quote
        </a>
      </div>
    </div>
  </section>
  <MobileConvertBar client:load />
</BaseLayout>
