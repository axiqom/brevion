---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/base';
import MobileConvertBar from '../components/MobileConvertBar';

type Industry = {
  name: string;
  img?: string;
  alt?: string;
  span: string;
  object?: string;
};

const industries: Industry[] = [
  {
    name: 'Aerospace',
    img: withBase('media/ind-aerospace.jpg'),
    alt: 'Jet engine turbine cutaway with precision machined blades',
    span: 'md:col-span-2',
    object: 'object-[center_40%]',
  },
  {
    name: 'Defense',
    img: withBase('media/ind-defense.jpg'),
    alt: 'F-35 fighter aircraft in a clean hangar',
    span: 'md:col-span-1',
    object: 'object-center',
  },
  {
    name: 'Medical',
    img: withBase('media/ind-medical.jpg'),
    alt: 'Precision metal and polymer orthopedic implant components',
    span: 'md:col-span-1',
    object: 'object-center',
  },
  {
    name: 'Robotics',
    img: withBase('media/ind-robotics.jpg'),
    alt: 'Industrial robotic arms assembling a vehicle chassis',
    span: 'md:col-span-2',
    object: 'object-[center_45%]',
  },
  {
    name: 'Industrial',
    img: withBase('media/ind-industrial.jpg'),
    alt: 'CNC machining center on a clean production floor',
    span: 'md:col-span-2',
    object: 'object-center',
  },
  {
    name: 'Automotive',
    span: 'md:col-span-1',
  },
  {
    name: 'Energy',
    img: withBase('media/ind-energy.jpg'),
    alt: 'Wind turbines across an open field at sunset',
    span: 'md:col-span-1',
    object: 'object-[center_55%]',
  },
  {
    name: 'Consumer Products',
    span: 'md:col-span-2',
  },
];
---
<BaseLayout
  title="Industries — Brevion"
  description="CNC machining for aerospace, defense, medical, robotics, industrial, automotive, energy, and consumer products."
  currentPage="industries"
>
  <section class="border-b border-aluminum/35 bg-porcelain pt-28 pb-20 md:pt-36 md:pb-28">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <p class="mb-6 text-[11px] font-semibold uppercase tracking-[0.28em] text-aluminum">
        Industries
      </p>
      <h1 class="max-w-3xl text-4xl font-bold uppercase leading-[0.96] tracking-tight text-carbon md:text-5xl lg:text-6xl xl:text-7xl">
        Industries We Serve
      </h1>
    </div>
  </section>

  <section class="bg-porcelain pb-28 md:pb-36">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 gap-4 md:grid-cols-3 md:gap-5">
        {industries.map((ind) => (
          <div
            class={`group relative aspect-[4/3] min-h-[280px] overflow-hidden rounded-xl sm:min-h-[320px] md:aspect-auto md:min-h-[380px] md:rounded-2xl ${ind.img ? 'bg-carbon' : 'border border-aluminum/35 bg-aluminum/12'} ${ind.span}`}
          >
            {ind.img ? (
              <>
                <img
                  src={ind.img}
                  alt={ind.alt}
                  class={`absolute inset-0 h-full w-full object-cover opacity-70 transition-[transform,opacity] duration-700 motion-reduce:transition-none group-hover:scale-[1.04] group-hover:opacity-90 ${ind.object ?? 'object-center'}`}
                  loading="lazy"
                  decoding="async"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-carbon/92 via-carbon/40 to-transparent" />
                <div class="absolute inset-0 flex flex-col justify-end p-7 sm:p-8 md:p-10">
                  <h2 class="text-xl font-bold uppercase tracking-tight text-porcelain sm:text-2xl md:text-3xl">
                    {ind.name}
                  </h2>
                </div>
              </>
            ) : (
              <div class="absolute inset-0 flex flex-col justify-end p-7 sm:p-8 md:p-10">
                <div class="mb-auto mt-10 h-px w-16 bg-aluminum/80" aria-hidden="true" />
                <p class="mb-4 text-[11px] font-semibold uppercase tracking-[0.22em] text-aluminum">
                  Precision parts
                </p>
                <h2 class="text-2xl font-bold uppercase tracking-tight text-carbon sm:text-3xl md:text-4xl">
                  {ind.name}
                </h2>
              </div>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="cta" class="border-t border-aluminum/35 bg-aluminum/10 py-28 md:py-36">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col items-start justify-between gap-10 md:flex-row md:items-center">
        <h2 class="max-w-xl text-3xl font-bold uppercase tracking-tight text-carbon md:text-4xl lg:text-5xl">
          Ready to Start?
        </h2>
        <a href={withBase('rfq')} class="btn-primary px-8 py-4">
          Request a Quote
        </a>
      </div>
    </div>
  </section>
  <MobileConvertBar client:load />
</BaseLayout>
