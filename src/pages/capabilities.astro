---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/base';
import MobileConvertBar from '../components/MobileConvertBar';

const capabilities = [
  {
    num: '01',
    title: 'CNC Milling',
    slug: 'milling',
    line: 'High-precision machining for complex components.',
    img: withBase('media/cap-manufacturing.jpg'),
    alt: 'CNC machining center cutting a precision metal part',
  },
  {
    num: '02',
    title: 'CNC Turning',
    slug: 'turning',
    line: 'Production-ready turned components.',
    img: withBase('media/cap-finishing.jpg'),
    alt: 'Finished precision turned and machined parts',
  },
  {
    num: '03',
    title: 'Prototype Manufacturing',
    slug: 'prototype',
    line: 'CAD to first articles.',
    img: withBase('media/cap-engineering.jpg'),
    alt: 'Engineer reviewing CAD model and toolpaths on a workstation',
  },
  {
    num: '04',
    title: 'Production Manufacturing',
    slug: 'production',
    line: 'Repeatable process control.',
    img: withBase('media/cap-manufacturing.jpg'),
    alt: 'CNC production machining of precision metal components',
  },
  {
    num: '05',
    title: 'Assembly',
    slug: 'assembly',
    line: 'Machining and build in one handoff.',
    img: withBase('media/cap-finishing.jpg'),
    alt: 'Assembled precision components ready for delivery',
  },
  {
    num: '06',
    title: 'Inspection',
    slug: 'inspection',
    line: 'Inspection throughout every stage of manufacturing.',
    img: withBase('media/cap-quality.jpg'),
    alt: 'Coordinate measuring machine inspecting a machined component',
  },
];
---
<BaseLayout
  title="Capabilities — Brevion"
  description="CNC milling, CNC turning, prototype and production manufacturing, assembly, and inspection."
  currentPage="capabilities"
>
  <section class="border-b border-aluminum/40 bg-porcelain py-24 md:py-32">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <p class="mb-5 text-[11px] font-semibold uppercase tracking-[0.22em] text-aluminum">
        Capabilities
      </p>
      <h1 class="max-w-3xl text-4xl font-bold uppercase tracking-tight text-carbon md:text-5xl lg:text-6xl">
        What we machine
      </h1>
      <p class="mt-6 max-w-xl text-base font-medium text-carbon/65 md:text-lg">
        CNC milling, turning, prototype, production, assembly, and inspection.
      </p>
    </div>
  </section>

  <section class="bg-porcelain pb-8 md:pb-12">
    <div class="mx-auto max-w-7xl space-y-5 px-4 sm:px-6 md:space-y-6 lg:px-8">
      {capabilities.map((cap, idx) => (
        <article
          class={`group grid overflow-hidden rounded-xl bg-aluminum/10 md:rounded-2xl lg:grid-cols-2 ${
            idx % 2 === 1 ? 'lg:[&>figure]:order-2' : ''
          }`}
        >
          <figure class="relative aspect-[16/10] overflow-hidden bg-carbon lg:aspect-auto lg:min-h-[380px]">
            <img
              src={cap.img}
              alt={cap.alt}
              class="absolute inset-0 h-full w-full object-cover opacity-80 transition-transform duration-700 motion-reduce:transition-none group-hover:scale-[1.03]"
              loading="lazy"
              decoding="async"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-carbon/50 via-transparent to-transparent lg:bg-gradient-to-r lg:from-transparent lg:via-transparent lg:to-carbon/20" />
            <span class="absolute left-5 top-5 font-display text-3xl font-bold tabular-nums tracking-tight text-porcelain/80 md:left-6 md:top-6 md:text-4xl">
              {cap.num}
            </span>
          </figure>
          <div class="flex flex-col justify-center px-6 py-10 sm:px-8 md:px-12 md:py-14">
            <h2 class="mb-4 text-2xl font-bold uppercase tracking-tight text-carbon md:text-3xl lg:text-4xl">
              {cap.title}
            </h2>
            <p class="mb-8 max-w-md text-base font-medium leading-relaxed text-carbon/65 md:text-lg">
              {cap.line}
            </p>
            <a
              href={withBase(`rfq?capability=${cap.slug}`)}
              class="inline-flex min-h-11 w-fit items-center text-sm font-semibold uppercase tracking-widest text-carbon transition-colors duration-150 hover:text-gold"
            >
              Start RFQ →
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section id="cta" class="relative overflow-hidden border-t border-aluminum/40 bg-carbon py-24 md:py-32">
    <div class="absolute inset-0">
      <img
        src={withBase('media/bg-cta.jpg')}
        alt=""
        class="h-full w-full object-cover opacity-35"
        aria-hidden="true"
        loading="lazy"
        decoding="async"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-carbon via-carbon/80 to-carbon/55" aria-hidden="true" />
    </div>
    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col items-start justify-between gap-8 md:flex-row md:items-center">
        <h2 class="text-3xl font-bold uppercase tracking-tight text-porcelain md:text-4xl lg:text-5xl">
          Ready to Start?
        </h2>
        <a
          href={withBase('rfq')}
          class="inline-flex min-h-11 items-center justify-center rounded-lg bg-porcelain px-8 py-4 text-sm font-semibold uppercase tracking-widest text-carbon transition-colors duration-150 hover:bg-gold"
        >
          Request a Quote
        </a>
      </div>
    </div>
  </section>
  <MobileConvertBar client:load />
</BaseLayout>
