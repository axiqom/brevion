---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/base';
import ExpandableCardGrid from '../components/ExpandableCard';
import MidCta from '../components/sections/MidCta.astro';
import MobileConvertBar from '../components/MobileConvertBar';

const capabilities = [
  {
    id: 'milling',
    num: '01',
    title: 'CNC Milling',
    line: 'Multi-axis milling for complex geometry.',
    img: withBase('media/cap-manufacturing.jpg'),
    alt: '5-axis CNC machining center with open enclosure and control console',
    objectClass: 'object-[center_40%]',
    facts: [
      '3-, 4-, and 5-axis milling.',
      'Metals and engineering plastics.',
      'Prototype through production lots.',
    ],
    rfqSlug: 'milling',
  },
  {
    id: 'turning',
    num: '02',
    title: 'CNC Turning',
    line: 'Turned components ready for production.',
    img: withBase('media/cap-turning.jpg'),
    alt: 'CNC lathe chuck holding a turned metal workpiece with turret tooling',
    facts: [
      'Lathe work for diameters and features.',
      'Common metals and bar stock.',
      'Fits milling when parts need both.',
    ],
    rfqSlug: 'turning',
  },
  {
    id: 'prototype',
    num: '03',
    title: 'Prototype Manufacturing',
    line: 'CAD to first articles.',
    img: withBase('media/cap-engineering.jpg'),
    alt: 'Vertical machining center used for prototype and first-article work',
    facts: [
      'Low volume first articles from CAD.',
      'Design review before cut.',
      'Path to production when the design locks.',
    ],
    rfqSlug: 'prototype',
  },
  {
    id: 'production',
    num: '04',
    title: 'Production Manufacturing',
    line: 'Repeatable process control.',
    img: withBase('media/cap-production.jpg'),
    alt: 'Clean production floor with multiple CNC milling machines',
    objectClass: 'object-[center_45%]',
    facts: [
      'Repeatable setups for production lots.',
      'Process control across the run.',
      'Inspection checkpoints as specified.',
    ],
    rfqSlug: 'production',
  },
  {
    id: 'assembly',
    num: '05',
    title: 'Assembly',
    line: 'Machining and build in one handoff.',
    img: withBase('media/cap-assembly.jpg'),
    alt: 'Precision assembly of electronics into a machined housing',
    facts: [
      'Machined parts plus build in one handoff.',
      'Mechanical and light electronics fit-up.',
      'Reduces multi-vendor coordination.',
    ],
    rfqSlug: 'assembly',
  },
  {
    id: 'inspection',
    num: '06',
    title: 'Inspection',
    line: 'Inspection throughout every stage of manufacturing.',
    img: withBase('media/cap-quality.jpg'),
    alt: 'Coordinate measuring machine probe over a granite surface plate',
    objectClass: 'object-[center_35%]',
    facts: [
      'In-process and final dimensional checks.',
      'CMM and standard metrology tools.',
      'Documentation when the print requires it.',
    ],
    rfqSlug: 'inspection',
  },
];
---
<BaseLayout
  title="Capabilities — Brevion"
  description="CNC milling, CNC turning, prototype and production manufacturing, assembly, and inspection."
  currentPage="capabilities"
>
  <section class="border-b border-aluminum/35 bg-porcelain pt-24 pb-14 sm:pt-28 sm:pb-20 md:pt-36 md:pb-28">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <p class="mb-5 text-[11px] font-semibold uppercase tracking-[0.28em] text-aluminum sm:mb-6">
        Capabilities
      </p>
      <h1 class="max-w-3xl text-3xl font-bold uppercase leading-[0.96] tracking-tight text-carbon sm:text-4xl md:text-5xl lg:text-6xl xl:text-7xl">
        What we machine
      </h1>
      <p class="mt-6 max-w-lg text-base font-medium leading-relaxed text-carbon/60 sm:mt-8 md:text-lg">
        CNC milling, turning, prototype, production, assembly, and inspection. Open a card for detail.
      </p>
    </div>
  </section>

  <section class="bg-porcelain pb-14 sm:pb-16 md:pb-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <ExpandableCardGrid client:load items={capabilities} />
    </div>
  </section>

  <MidCta line="Have CAD for milling, turning, or a full build? Start a quote." />

  <section id="cta" class="relative overflow-hidden border-t border-aluminum/40 bg-carbon py-20 sm:py-28 md:py-36">
    <div class="absolute inset-0">
      <img
        src={withBase('media/bg-cta.jpg')}
        alt=""
        class="h-full w-full object-cover opacity-30"
        aria-hidden="true"
        loading="lazy"
        decoding="async"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-carbon via-carbon/85 to-carbon/60" aria-hidden="true" />
    </div>
    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col items-stretch justify-between gap-8 sm:items-start sm:gap-10 md:flex-row md:items-center">
        <h2 class="max-w-xl text-2xl font-bold uppercase tracking-tight text-porcelain sm:text-3xl md:text-4xl lg:text-5xl">
          Ready to Start?
        </h2>
        <a
          href={withBase('rfq')}
          class="inline-flex min-h-12 w-full items-center justify-center rounded-lg bg-porcelain px-8 py-4 text-sm font-semibold uppercase tracking-widest text-carbon transition-colors duration-150 hover:bg-gold sm:min-h-11 sm:w-auto"
        >
          Request a Quote
        </a>
      </div>
    </div>
  </section>
  <MobileConvertBar client:load />
</BaseLayout>
