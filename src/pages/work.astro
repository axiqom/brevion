---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/base';
import MobileConvertBar from '../components/MobileConvertBar';

const projects = [
  {
    title: 'Titanium Aerospace Bracket',
    industry: 'Aerospace',
    material: 'Ti-6Al-4V',
    tolerance: '±0.0005"',
    img: withBase('media/port-01.jpg'),
    alt: 'Precision-machined titanium aerospace bracket on a dark surface',
  },
  {
    title: 'Optical Sensor Housing',
    industry: 'Defense',
    material: 'Aluminum 7075-T6',
    tolerance: '±0.0002"',
    img: withBase('media/port-02.jpg'),
    alt: 'Machined aluminum optical sensor housing with fine surface finish',
  },
];
---
<BaseLayout
  title="Work — Brevion"
  description="Sample CNC work — material, tolerance, and industry."
  currentPage="work"
>
  <section class="border-b border-aluminum/40 bg-porcelain py-20 md:py-28">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <p class="mb-4 text-[11px] font-semibold uppercase tracking-[0.22em] text-aluminum">
        Work
      </p>
      <h1 class="max-w-3xl text-4xl font-bold uppercase tracking-tight text-carbon md:text-5xl lg:text-6xl">
        Sample work
      </h1>
      <p class="mt-6 max-w-xl text-base font-medium text-carbon/65 md:text-lg">
        Material. Tolerance. Industry.
      </p>
    </div>
  </section>

  <section class="bg-porcelain pb-20 md:pb-28">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="space-y-20 md:space-y-28">
        {projects.map((proj, idx) => (
          <div class={`flex flex-col items-stretch gap-10 lg:gap-16 ${idx % 2 !== 0 ? 'lg:flex-row-reverse' : 'lg:flex-row'}`}>
            <figure class="relative aspect-[5/4] w-full overflow-hidden rounded-xl bg-carbon md:rounded-2xl lg:w-1/2">
              <img
                src={proj.img}
                alt={proj.alt}
                class="absolute inset-0 h-full w-full object-cover opacity-90 transition-transform duration-500 motion-reduce:transition-none hover:scale-[1.02]"
                loading="lazy"
                decoding="async"
              />
              <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-carbon/40 to-transparent" aria-hidden="true" />
            </figure>

            <div class="flex w-full flex-col justify-center lg:w-1/2">
              <p class="mb-3 text-[11px] font-semibold uppercase tracking-[0.2em] text-aluminum">
                {proj.industry}
              </p>
              <h2 class="mb-10 text-2xl font-bold uppercase leading-tight tracking-tight text-carbon md:mb-12 md:text-3xl lg:text-4xl">
                {proj.title}
              </h2>

              <dl class="grid grid-cols-2 gap-8 border-t border-aluminum/40 pt-8">
                <div>
                  <dt class="mb-2 text-xs font-semibold uppercase tracking-widest text-aluminum">Material</dt>
                  <dd class="text-base font-semibold text-carbon md:text-lg">{proj.material}</dd>
                </div>
                <div>
                  <dt class="mb-2 text-xs font-semibold uppercase tracking-widest text-aluminum">Tolerance</dt>
                  <dd class="text-base font-semibold text-carbon md:text-lg">{proj.tolerance}</dd>
                </div>
              </dl>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="cta" class="border-t border-aluminum/40 bg-aluminum/10 py-20 md:py-28">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col items-start justify-between gap-8 md:flex-row md:items-center">
        <h2 class="text-3xl font-bold uppercase tracking-tight text-carbon md:text-4xl">
          Ready to Start?
        </h2>
        <a href={withBase('rfq')} class="btn-primary px-8 py-4">
          Request a Quote
        </a>
      </div>
    </div>
  </section>
  <MobileConvertBar client:load />
</BaseLayout>
