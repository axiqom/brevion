---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/base';
import MobileConvertBar from '../components/MobileConvertBar';

const projects = [
  {
    title: 'Titanium airfoil',
    material: 'Titanium',
    focus: 'Contour',
    img: withBase('media/port-01.jpg'),
    alt: 'Transonic turbine blade cascade in a precision test rig',
  },
  {
    title: 'Aluminum housing',
    material: 'Aluminum',
    focus: 'Bore finish',
    img: withBase('media/port-02.jpg'),
    alt: 'Machined aluminum alloy housings with finished flange faces and threaded bores',
  },
];
---
<BaseLayout
  title="Work — Brevion"
  description="Sample CNC machining work. Material and focus for representative jobs."
  currentPage="work"
>
  <section class="border-b border-aluminum/35 bg-porcelain pt-28 pb-20 md:pt-36 md:pb-28">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <p class="mb-6 text-[11px] font-semibold uppercase tracking-[0.28em] text-aluminum">
        Work
      </p>
      <h1 class="max-w-3xl text-4xl font-bold uppercase leading-[0.96] tracking-tight text-carbon md:text-5xl lg:text-6xl xl:text-7xl">
        Sample work
      </h1>
      <p class="mt-8 max-w-lg text-base font-medium leading-relaxed text-carbon/60 md:text-lg">
        Representative jobs — material and focus.
      </p>
    </div>
  </section>

  <section class="bg-porcelain py-20 md:py-28">
    <div class="mx-auto max-w-7xl space-y-24 px-4 sm:px-6 md:space-y-32 lg:px-8">
      {projects.map((proj, idx) => (
        <div
          class={`flex flex-col items-stretch gap-12 lg:gap-20 ${
            idx % 2 !== 0 ? 'lg:flex-row-reverse' : 'lg:flex-row'
          }`}
        >
          <figure class="group relative aspect-[5/4] w-full overflow-hidden rounded-xl bg-carbon md:rounded-2xl lg:w-[58%]">
            <img
              src={proj.img}
              alt={proj.alt}
              class="absolute inset-0 h-full w-full object-cover opacity-90 transition-transform duration-700 motion-reduce:transition-none group-hover:scale-[1.03]"
              loading="lazy"
              decoding="async"
            />
            <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-carbon/40 to-transparent" aria-hidden="true" />
          </figure>

          <div class="flex w-full flex-col justify-center lg:w-[42%]">
            <h2 class="mb-12 text-2xl font-bold uppercase leading-tight tracking-tight text-carbon md:mb-14 md:text-3xl lg:text-4xl">
              {proj.title}
            </h2>
            <div class="flex gap-14 border-t border-aluminum/40 pt-8">
              <div>
                <span class="mb-2 block text-[11px] font-semibold uppercase tracking-widest text-aluminum">
                  Material
                </span>
                <span class="text-lg font-semibold text-carbon md:text-xl">{proj.material}</span>
              </div>
              <div>
                <span class="mb-2 block text-[11px] font-semibold uppercase tracking-widest text-aluminum">
                  Focus
                </span>
                <span class="text-lg font-semibold text-carbon md:text-xl">{proj.focus}</span>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section id="cta" class="relative overflow-hidden border-t border-aluminum/40 bg-carbon py-28 md:py-36">
    <div class="absolute inset-0">
      <img
        src={withBase('media/bg-cta.jpg')}
        alt=""
        class="h-full w-full object-cover opacity-30"
        aria-hidden="true"
        loading="lazy"
        decoding="async"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-carbon via-carbon/85 to-carbon/60" aria-hidden="true" />
    </div>
    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col items-start justify-between gap-10 md:flex-row md:items-center">
        <h2 class="max-w-xl text-3xl font-bold uppercase tracking-tight text-porcelain md:text-4xl lg:text-5xl">
          Ready to Start?
        </h2>
        <a
          href={withBase('rfq')}
          class="inline-flex min-h-11 items-center justify-center rounded-lg bg-porcelain px-8 py-4 text-sm font-semibold uppercase tracking-widest text-carbon transition-colors duration-150 hover:bg-gold"
        >
          Request a Quote
        </a>
      </div>
    </div>
  </section>
  <MobileConvertBar client:load />
</BaseLayout>
