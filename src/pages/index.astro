---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Industries from '../components/sections/Industries.astro';
import Capabilities from '../components/sections/Capabilities.astro';
import MidCta from '../components/sections/MidCta.astro';
import Timeline from '../components/sections/Timeline.astro';
import WhyChooseUs from '../components/sections/WhyChooseUs.astro';
import Materials from '../components/sections/Materials.astro';
import Cta from '../components/sections/Cta.astro';
import MobileConvertBar from '../components/MobileConvertBar';
---
<BaseLayout
  title="Brevion — Advanced Precision Manufacturing"
  description="CNC machining for prototype and production. CNC milling, CNC turning, assembly, and inspection."
  currentPage="home"
>
  <Hero />
  <Capabilities />
  <MidCta line="Ready for milling, turning, prototype, or inspection? Start a quote." />
  <Industries />
  <MidCta line="Aerospace, defense, medical, or robotics parts — send the drawing." />
  <Timeline />
  <WhyChooseUs />
  <Materials />
  <Cta />
  <MobileConvertBar client:load />
</BaseLayout>
