---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Industries from '../components/sections/Industries.astro';
import Capabilities from '../components/sections/Capabilities.astro';
import MidCta from '../components/sections/MidCta.astro';
import HowQuotingWorks from '../components/sections/HowQuotingWorks.astro';
import Materials from '../components/sections/Materials.astro';
import Faq from '../components/sections/Faq';
import Cta from '../components/sections/Cta.astro';
import MobileConvertBar from '../components/MobileConvertBar';
---
<BaseLayout
  title="Brevion — CNC Machining for Prototype & Production"
  description="Brevion is a precision CNC partner for mechanical and sourcing engineers: milling, turning, assembly, and inspection. Send STEP + PDF — email sales@brevion.com or start an RFQ."
  currentPage="home"
  path=""
  includeFaqSchema={true}
>
  <Hero />
  <Capabilities />
  <MidCta line="Have a STEP and drawing? Send the files — start a quote or email sales@brevion.com." />
  <Industries />
  <HowQuotingWorks />
  <Materials />
  <Faq client:visible />
  <Cta />
  <MobileConvertBar client:load />
</BaseLayout>
