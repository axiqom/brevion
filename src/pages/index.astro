---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import LogoCloud from '../components/sections/LogoCloud.astro';
import ValueProp from '../components/sections/ValueProp.astro';
import Capabilities from '../components/sections/Capabilities.astro';
import Industries from '../components/sections/Industries.astro';
import Timeline from '../components/sections/Timeline.astro';
import Portfolio from '../components/sections/Portfolio.astro';
