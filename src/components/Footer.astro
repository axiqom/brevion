---
import BrandLogo from './BrandLogo.astro';
import { withBase } from '../lib/base';
import { CONTACT_EMAIL, CONTACT_MAILTO, PUBLIC_PHONE } from '../lib/site';

const companyLinks = [
  { label: 'Home', href: withBase() },
  { label: 'Capabilities', href: withBase('capabilities') },
  { label: 'Industries', href: withBase('industries') },
  { label: 'Work', href: withBase('work') },
  { label: 'How quoting works', href: withBase('#process') },
  { label: 'FAQ', href: withBase('#faq') },
];
---
<footer class="border-t border-aluminum/50 bg-porcelain py-12 pb-[max(7rem,calc(5.5rem+env(safe-area-inset-bottom)))] text-aluminum sm:py-14 md:pb-14">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-10 md:grid-cols-4 md:gap-12">
      <div class="col-span-1 md:col-span-2">
        <a href={withBase()} class="mb-5 flex w-fit max-w-[min(100%,12rem)] items-center gap-3 rounded-lg sm:max-w-none" aria-label="Brevion home">
          <BrandLogo surface="footer" />
        </a>
        <p class="max-w-sm text-sm font-medium leading-relaxed text-carbon/60">
          Brevion (Brevion Systems) is a precision CNC manufacturing partner for prototype and production.
        </p>
      </div>
      <div>
        <h4 class="mb-4 text-sm font-bold uppercase tracking-widest text-carbon">Company</h4>
        <ul class="space-y-1 text-sm font-medium text-carbon/70">
          {companyLinks.map((link) => (
            <li>
              <a href={link.href} class="inline-flex min-h-11 items-center rounded-sm transition-colors duration-150 hover:text-gold">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <h4 class="mb-4 text-sm font-bold uppercase tracking-widest text-carbon">Contact</h4>
        <ul class="space-y-1 text-sm font-medium text-carbon/70">
          <li>
            <a href={CONTACT_MAILTO} class="inline-flex min-h-11 items-center rounded-sm transition-colors duration-150 hover:text-gold">
              {CONTACT_EMAIL}
            </a>
          </li>
          {PUBLIC_PHONE ? (
            <li>
              <a href={`tel:${PUBLIC_PHONE.replace(/[^\d+]/g, '')}`} class="inline-flex min-h-11 items-center rounded-sm transition-colors duration-150 hover:text-gold">
                {PUBLIC_PHONE}
              </a>
            </li>
          ) : null}
          <li>
            <a href={withBase('rfq')} class="inline-flex min-h-11 items-center rounded-sm transition-colors duration-150 hover:text-gold">
              Request a Quote
            </a>
          </li>
        </ul>
      </div>
    </div>
    <div class="mt-10 flex flex-col items-center justify-between gap-4 border-t border-aluminum/40 pt-8 text-xs font-semibold uppercase tracking-widest text-aluminum sm:mt-12 md:flex-row">
      <p>&copy; {new Date().getFullYear()} Brevion Systems.</p>
      <div class="flex flex-wrap justify-center gap-x-6 gap-y-2">
        <a href="#" class="inline-flex min-h-11 items-center rounded-sm text-carbon/60 transition-colors duration-150 hover:text-gold">Privacy Policy</a>
        <a href="#" class="inline-flex min-h-11 items-center rounded-sm text-carbon/60 transition-colors duration-150 hover:text-gold">Terms of Service</a>
      </div>
    </div>
  </div>
</footer>
