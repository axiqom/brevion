---
import BrandLogo from './BrandLogo.astro';
import { withBase } from '../lib/base';
---
<footer class="border-t border-aluminum/50 bg-porcelain py-12 pb-28 text-aluminum sm:py-14 md:pb-14">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-10 md:grid-cols-4 md:gap-12">
      <div class="col-span-1 md:col-span-2">
        <a href={withBase()} class="mb-5 flex w-fit items-center gap-3 rounded-lg" aria-label="Brevion home">
          <BrandLogo surface="footer" />
        </a>
        <p class="max-w-sm text-sm font-medium leading-relaxed text-carbon/60">
          CNC machining for prototype and production.
        </p>
      </div>
      <div>
        <h4 class="mb-4 text-sm font-bold uppercase tracking-widest text-carbon">Company</h4>
        <ul class="space-y-1 text-sm font-medium text-carbon/70">
          <li><a href={withBase('#industries')} class="inline-flex min-h-11 items-center rounded-sm transition-colors duration-150 hover:text-gold">Industries</a></li>
          <li><a href={withBase('#capabilities')} class="inline-flex min-h-11 items-center rounded-sm transition-colors duration-150 hover:text-gold">Capabilities</a></li>
          <li><a href={withBase('#process')} class="inline-flex min-h-11 items-center rounded-sm transition-colors duration-150 hover:text-gold">Process</a></li>
          <li><a href={withBase('#materials')} class="inline-flex min-h-11 items-center rounded-sm transition-colors duration-150 hover:text-gold">Materials</a></li>
        </ul>
      </div>
      <div>
        <h4 class="mb-4 text-sm font-bold uppercase tracking-widest text-carbon">Contact</h4>
        <ul class="space-y-1 text-sm font-medium text-carbon/70">
          <li>
            <a href="mailto:sales@brevion.com" class="inline-flex min-h-11 items-center rounded-sm transition-colors duration-150 hover:text-gold">
              sales@brevion.com
            </a>
          </li>
          <li>
            <a href={withBase('rfq')} class="inline-flex min-h-11 items-center rounded-sm transition-colors duration-150 hover:text-gold">
              Request a Quote
            </a>
          </li>
        </ul>
      </div>
    </div>
    <div class="mt-10 flex flex-col items-center justify-between gap-4 border-t border-aluminum/40 pt-8 text-xs font-semibold uppercase tracking-widest text-aluminum sm:mt-12 md:flex-row">
      <p>&copy; {new Date().getFullYear()} Brevion Systems.</p>
      <div class="flex flex-wrap justify-center gap-x-6 gap-y-2">
        <a href="#" class="inline-flex min-h-11 items-center rounded-sm text-carbon/60 transition-colors duration-150 hover:text-gold">Privacy Policy</a>
        <a href="#" class="inline-flex min-h-11 items-center rounded-sm text-carbon/60 transition-colors duration-150 hover:text-gold">Terms of Service</a>
      </div>
    </div>
  </div>
</footer>
