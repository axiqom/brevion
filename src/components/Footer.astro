---
import { withBase } from '../lib/base';
---
<footer class="border-t border-zinc-900 bg-zinc-950 py-12 text-zinc-500 sm:py-16">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-10 sm:gap-12 md:grid-cols-4">
      <div class="col-span-1 md:col-span-2">
        <a href={withBase()} class="mb-6 flex w-fit items-center gap-3 rounded-lg" aria-label="MillTrue home">
          <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-white">
            <img
              src={withBase('milltrue-mark.svg')}
              alt=""
              width={22}
              height={22}
              class="h-[22px] w-[22px]"
              aria-hidden="true"
            />
          </div>
          <span class="font-display text-xl font-bold uppercase tracking-widest text-white sm:text-2xl">
            MillTrue
          </span>
        </a>
        <p class="max-w-sm text-sm font-medium leading-relaxed">
          Precision manufacturing for mission-critical industries. From prototype to production, we deliver components that perform in the most demanding environments.
        </p>
      </div>
      <div>
        <h4 class="mb-6 text-sm font-bold uppercase tracking-widest text-white">Company</h4>
        <ul class="space-y-4 text-sm font-medium">
          <li><a href={withBase('#capabilities')} class="inline-flex min-h-11 items-center rounded-sm transition-colors hover:text-white">Capabilities</a></li>
          <li><a href={withBase('#industries')} class="inline-flex min-h-11 items-center rounded-sm transition-colors hover:text-white">Industries</a></li>
          <li><a href={withBase('#projects')} class="inline-flex min-h-11 items-center rounded-sm transition-colors hover:text-white">Projects</a></li>
          <li><a href={withBase('#about')} class="inline-flex min-h-11 items-center rounded-sm transition-colors hover:text-white">About Us</a></li>
        </ul>
      </div>
      <div>
        <h4 class="mb-6 text-sm font-bold uppercase tracking-widest text-white">Contact</h4>
        <ul class="space-y-4 text-sm font-medium">
          <li>
            <a href="mailto:sales@milltrue.com" class="inline-flex min-h-11 items-center rounded-sm transition-colors hover:text-white">
              sales@milltrue.com
            </a>
          </li>
          <li>
            <a href="tel:+155****4567" class="inline-flex min-h-11 items-center rounded-sm transition-colors hover:text-white">
              +1 (555) 123-4567
            </a>
          </li>
          <li>100 Precision Way<br />Austin, TX 78744</li>
        </ul>
      </div>
    </div>
    <div class="mt-12 flex flex-col items-center justify-between gap-4 border-t border-zinc-900 pt-8 text-xs font-bold uppercase tracking-widest sm:mt-16 md:flex-row">
      <p>&copy; {new Date().getFullYear()} MillTrue Manufacturing.</p>
      <div class="flex flex-wrap justify-center gap-x-6 gap-y-2">
        <a href="#" class="inline-flex min-h-11 items-center rounded-sm transition-colors hover:text-white">Privacy Policy</a>
        <a href="#" class="inline-flex min-h-11 items-center rounded-sm transition-colors hover:text-white">Terms of Service</a>
      </div>
    </div>
  </div>
</footer>
