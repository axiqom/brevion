---
const points = [
  {
    title: 'Experienced Engineers',
    detail: 'Process planning and CAM from people who have cut the same part classes before.',
  },
  {
    title: 'Modern Equipment',
    detail: 'Multi-axis CNC mills and lathes sized for prototype through production lots.',
  },
  {
    title: 'Tight Tolerances',
    detail: 'Held to the print — including fine fits when the drawing calls for them.',
  },
  {
    title: 'Reliable Lead Times',
    detail: 'Quoted dates based on current load, not a generic marketplace SLA.',
  },
  {
    title: 'Quality Inspection',
    detail: 'Inspection planned with the job, not bolted on after scrap risk appears.',
  },
];
---
<section id="why-brevion" class="scroll-mt-28 border-t border-aluminum/35 bg-aluminum/10 py-28 md:py-40">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid gap-16 lg:grid-cols-12 lg:gap-28">
      <div class="lg:col-span-4">
        <p class="mb-5 text-[11px] font-semibold uppercase tracking-[0.28em] text-aluminum">
          Why Brevion
        </p>
        <h2 class="text-3xl font-bold uppercase tracking-tight text-carbon md:text-4xl lg:text-5xl">
          Built to tolerance
        </h2>
      </div>
      <div class="grid grid-cols-1 gap-x-14 sm:grid-cols-2 lg:col-span-8">
        {points.map((point) => (
          <details class="group border-t border-aluminum/40">
            <summary class="flex cursor-pointer list-none items-start justify-between gap-4 py-8 text-left outline-none transition-colors duration-150 hover:text-gold focus-visible:ring-2 focus-visible:ring-gold focus-visible:ring-offset-2 focus-visible:ring-offset-porcelain [&::-webkit-details-marker]:hidden">
              <span class="text-lg font-medium text-carbon md:text-xl lg:text-2xl">
                {point.title}
              </span>
              <span
                class="mt-1 shrink-0 text-xl font-light leading-none text-carbon transition-transform duration-150 group-open:rotate-45"
                aria-hidden="true"
              >
                +
              </span>
            </summary>
            <p class="pb-8 text-sm font-medium leading-relaxed text-carbon/65 md:text-base">
              {point.detail}
            </p>
          </details>
        ))}
      </div>
    </div>
  </div>
</section>
