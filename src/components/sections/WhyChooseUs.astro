---
const points = [
  'Experienced Engineers',
  'Modern Equipment',
  'Tight Tolerances',
  'Reliable Lead Times',
  'Quality Inspection',
];
---
<section id="why-brevion" class="scroll-mt-28 border-t border-aluminum/40 bg-aluminum/10 py-28 md:py-36">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid gap-16 lg:grid-cols-12 lg:gap-20">
      <div class="lg:col-span-4">
        <h2 class="text-3xl font-bold uppercase tracking-tight text-carbon md:text-4xl lg:text-5xl">
          Why Brevion
        </h2>
      </div>
      <ul class="grid grid-cols-1 gap-x-10 gap-y-0 sm:grid-cols-2 lg:col-span-8">
        {points.map((point) => (
          <li class="border-t border-aluminum/40 py-6 text-lg font-medium text-carbon md:text-xl">
            {point}
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
