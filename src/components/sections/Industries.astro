---
const industries = [
  'Aerospace',
  'Defense',
  'Medical',
  'Robotics',
  'Industrial',
  'Automotive',
  'Energy',
  'Consumer Products',
];
---
<section id="industries" class="scroll-mt-28 border-t border-aluminum/40 bg-porcelain py-28 md:py-36">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <h2 class="mb-14 text-3xl font-bold uppercase tracking-tight text-carbon md:mb-20 md:text-4xl lg:text-5xl">
      Industries We Serve
    </h2>

    <ul class="grid grid-cols-1 gap-x-12 gap-y-6 sm:grid-cols-2 md:grid-cols-4 md:gap-y-8">
      {industries.map((name) => (
        <li class="border-t border-aluminum/40 pt-5 text-base font-medium text-carbon md:text-lg">
          {name}
        </li>
      ))}
    </ul>
  </div>
</section>
