---
const industries = [
  {
    name: 'Aerospace',
    desc: 'Complex lightweight components built to exacting tolerances.',
    img: 'https://images.unsplash.com/photo-1541186877-bb5a745edde5?q=80&w=1200&auto=format&fit=crop',
    span: 'md:col-span-2',
  },
  {
    name: 'Defense',
    desc: 'Mission-critical parts manufactured with precision and consistency.',
    img: 'https://images.unsplash.com/photo-1579227114347-15d08fc37cae?q=80&w=800&auto=format&fit=crop',
    span: 'md:col-span-1',
  },
  {
    name: 'Space',
    desc: 'Launch systems. Ground support. Satellite hardware.',
    img: 'https://images.unsplash.com/photo-1517976487492-5750f3195933?q=80&w=800&auto=format&fit=crop',
    span: 'md:col-span-1',
  },
  {
    name: 'Medical',
    desc: 'Precision components where consistency matters.',
    img: 'https://images.unsplash.com/photo-1579684385127-1ef15d508118?q=80&w=1200&auto=format&fit=crop',
    span: 'md:col-span-2',
  },
  {
    name: 'Industrial Automation',
    desc: 'Machine components. Custom tooling. Fixtures.',
    img: 'https://images.unsplash.com/photo-1581092335397-9583eb92d232?q=80&w=1200&auto=format&fit=crop',
    span: 'md:col-span-2',
  },
  {
    name: 'Robotics',
    desc: 'High-performance components for automation systems.',
    img: 'https://images.unsplash.com/photo-1485827404703-89b55fcc595e?q=80&w=800&auto=format&fit=crop',
    span: 'md:col-span-1',
  },
];
---
<section id="industries" class="scroll-mt-28 border-t border-zinc-800 bg-zinc-900 py-20 md:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mb-12 max-w-2xl md:mb-14">
      <h2 class="mb-3 text-3xl font-bold uppercase tracking-tight text-white md:text-4xl lg:text-5xl">
        Industries
      </h2>
      <p class="text-base text-zinc-400 md:text-lg">
        Mission-critical hardware for aerospace, defense, space, medical, and automation.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-4 md:grid-cols-3 md:gap-5">
      {industries.map((ind) => (
        <div class={`group relative aspect-[4/3] min-h-[240px] overflow-hidden rounded-2xl border border-zinc-800 bg-zinc-950 sm:min-h-[280px] md:aspect-auto md:min-h-[320px] md:rounded-3xl ${ind.span}`}>
          <img
            src={ind.img}
            alt=""
            class="absolute inset-0 h-full w-full object-cover opacity-40 mix-blend-luminosity transition-transform duration-700 motion-reduce:transition-none group-hover:scale-[1.03]"
            data-placeholder="industry"
          />
          <div class="absolute inset-0 flex flex-col justify-end bg-gradient-to-t from-zinc-950 via-zinc-950/50 to-transparent p-6 sm:p-8 md:p-10">
            <h3 class="mb-1.5 text-xl font-bold uppercase tracking-tight text-white sm:text-2xl md:mb-2 md:text-3xl">
              {ind.name}
            </h3>
            <p class="max-w-sm text-sm font-medium text-zinc-400 md:text-base">{ind.desc}</p>
          </div>
          <span class="placeholder-caption">{ind.name} · Placeholder</span>
        </div>
      ))}
    </div>
  </div>
</section>
