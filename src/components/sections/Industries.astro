---
import { withBase } from '../../lib/base';
import ExpandableCardGrid from '../ExpandableCard';

const industries = [
  {
    id: 'aerospace',
    title: 'Aerospace',
    line: 'Flight hardware and structural components.',
    img: withBase('media/ind-aerospace.jpg'),
    alt: 'Jet engine turbine cutaway with precision machined blades',
    span: 'md:col-span-2',
    minHeightClass: 'min-h-[260px] sm:min-h-[300px] md:min-h-[360px]',
    facts: [
      'Tight-tolerance flight and structural parts.',
      'Metals used in airframe and engine work.',
      'Documentation when the program requires it.',
    ],
    rfqSlug: 'aerospace',
  },
  {
    id: 'defense',
    title: 'Defense',
    line: 'Controlled parts with traceability when specified.',
    img: withBase('media/ind-defense.jpg'),
    alt: 'F-35 fighter aircraft in a clean hangar',
    span: 'md:col-span-1',
    minHeightClass: 'min-h-[260px] sm:min-h-[300px] md:min-h-[360px]',
    facts: [
      'Machined components for defense programs.',
      'Traceability when the print calls for it.',
      'NDA and controlled-file handling available.',
    ],
    rfqSlug: 'defense',
  },
  {
    id: 'medical',
    title: 'Medical',
    line: 'Implant and instrument components.',
    img: withBase('media/ind-medical.jpg'),
    alt: 'Precision metal and polymer orthopedic implant components',
    span: 'md:col-span-1',
    minHeightClass: 'min-h-[260px] sm:min-h-[300px] md:min-h-[360px]',
    facts: [
      'Orthopedic and instrument components.',
      'Metals and medical-grade plastics.',
      'Surface and dimensional requirements per print.',
    ],
    rfqSlug: 'medical',
  },
  {
    id: 'robotics',
    title: 'Robotics',
    line: 'Structural and motion parts for automation.',
    img: withBase('media/ind-robotics.jpg'),
    alt: 'Industrial robotic arms assembling a vehicle chassis',
    span: 'md:col-span-2',
    minHeightClass: 'min-h-[260px] sm:min-h-[300px] md:min-h-[360px]',
    facts: [
      'Housings, brackets, and motion components.',
      'Prototype frames through production lots.',
      'Fits with assembly when needed.',
    ],
    rfqSlug: 'robotics',
  },
];
---
<section id="industries" class="scroll-mt-28 border-t border-aluminum/35 bg-porcelain py-28 md:py-40">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mb-16 flex flex-col justify-between gap-6 md:mb-24 md:flex-row md:items-end">
      <div class="max-w-xl">
        <p class="mb-5 text-[11px] font-semibold uppercase tracking-[0.28em] text-aluminum">
          Industries
        </p>
        <h2 class="text-3xl font-bold uppercase tracking-tight text-carbon md:text-4xl lg:text-5xl">
          Industries We Serve
        </h2>
        <p class="mt-5 max-w-md text-base font-medium leading-relaxed text-carbon/60 md:text-lg">
          Open a sector for typical part types and a quote path.
        </p>
      </div>
      <a
        href={withBase('industries')}
        class="inline-flex min-h-11 items-center text-sm font-semibold uppercase tracking-widest text-carbon transition-colors duration-150 hover:text-gold"
      >
        All industries →
      </a>
    </div>

    <ExpandableCardGrid
      client:load
      items={industries}
      columnsClass="grid grid-cols-1 gap-4 md:grid-cols-3 md:gap-5"
    />
  </div>
</section>
