---
import { withBase } from '../../lib/base';

const industries = [
  {
    name: 'Aerospace',
    img: withBase('media/ind-aerospace.jpg'),
    alt: 'Aircraft structure and precision aerospace hardware',
    span: 'md:col-span-2',
  },
  {
    name: 'Defense',
    img: withBase('media/ind-defense.jpg'),
    alt: 'Defense-grade precision machined components',
    span: 'md:col-span-1',
  },
  {
    name: 'Medical',
    img: withBase('media/ind-medical.jpg'),
    alt: 'Clean precision components for medical devices',
    span: 'md:col-span-1',
  },
  {
    name: 'Robotics',
    img: withBase('media/ind-robotics.jpg'),
    alt: 'Robotic arm and precision machined robotics parts',
    span: 'md:col-span-2',
  },
];
---
<section id="industries" class="scroll-mt-28 border-t border-aluminum/40 bg-porcelain py-28 md:py-36">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mb-14 flex flex-col justify-between gap-6 md:mb-20 md:flex-row md:items-end">
      <h2 class="max-w-xl text-3xl font-bold uppercase tracking-tight text-carbon md:text-4xl lg:text-5xl">
        Industries We Serve
      </h2>
      <a
        href={withBase('industries')}
        class="inline-flex min-h-11 items-center text-sm font-semibold uppercase tracking-widest text-carbon transition-colors duration-150 hover:text-gold"
      >
        All industries →
      </a>
    </div>

    <div class="grid grid-cols-1 gap-4 md:grid-cols-3 md:gap-5">
      {industries.map((ind) => (
        <a
          href={withBase('industries')}
          class={`group relative aspect-[4/3] min-h-[240px] overflow-hidden rounded-xl bg-carbon outline-none transition-transform duration-300 hover:-translate-y-0.5 focus-visible:ring-2 focus-visible:ring-gold focus-visible:ring-offset-2 focus-visible:ring-offset-porcelain motion-reduce:transition-none motion-reduce:hover:translate-y-0 sm:min-h-[280px] md:aspect-auto md:min-h-[340px] md:rounded-2xl ${ind.span}`}
        >
          <img
            src={ind.img}
            alt={ind.alt}
            class="absolute inset-0 h-full w-full object-cover opacity-70 transition-[transform,opacity] duration-700 motion-reduce:transition-none group-hover:scale-[1.04] group-hover:opacity-88"
            loading="lazy"
            decoding="async"
          />
          <div class="absolute inset-0 flex flex-col justify-end bg-gradient-to-t from-carbon/90 via-carbon/35 to-transparent p-6 sm:p-8 md:p-10">
            <h3 class="text-xl font-bold uppercase tracking-tight text-porcelain sm:text-2xl md:text-3xl">
              {ind.name}
            </h3>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
