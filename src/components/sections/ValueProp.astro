---
import { PenTool, Target, Layers } from 'lucide-react';

const pillars = [
  {
    icon: PenTool,
    title: 'DFM before chips fly',
    desc: 'Tolerance stack-ups, cost drivers, and material callouts reviewed before the first toolpath.',
    featured: false,
  },
  {
    icon: Target,
    title: 'First article to production',
    desc: 'Repeatable setups and fixturing so article one matches part one thousand.',
    featured: true,
  },
  {
    icon: Layers,
    title: 'One owner, clear lead time',
    desc: 'A single point of contact from quote through finishing, inspection, and ship.',
    featured: false,
  },
];
---
<section class="relative overflow-hidden border-b border-zinc-900/60 bg-zinc-950 py-20 md:py-24">
  <div class="relative z-10 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto mb-12 max-w-2xl text-center md:mb-16">
      <p class="mb-3 text-[11px] font-bold uppercase tracking-[0.22em] text-zinc-500">
        How we work
      </p>
      <h2 class="mb-4 text-3xl font-bold uppercase tracking-tight text-white md:text-4xl lg:text-5xl">
        Predictable manufacturing.
      </h2>
      <p class="text-base font-medium text-zinc-400 md:text-lg">
        Specs in. Lead time out. No black-box shop floors.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-3 md:gap-10">
      {pillars.map((pillar) => (
        <div class={`rounded-2xl bg-zinc-900/35 p-6 shadow-[0_16px_48px_rgba(0,0,0,0.22)] md:rounded-3xl md:p-8 ${pillar.featured ? 'md:bg-zinc-900/55' : ''}`}>
          <div class="mb-5 flex h-11 w-11 items-center justify-center rounded-xl bg-zinc-800/90 text-white">
            <pillar.icon size={20} strokeWidth={1.5} aria-hidden="true" />
          </div>
          <h3 class="mb-2.5 text-xl font-bold uppercase tracking-tight text-white md:text-2xl">
            {pillar.title}
          </h3>
          <p class="text-sm leading-relaxed text-zinc-400 md:text-base">
            {pillar.desc}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
