---
import { Layers, Cog, Workflow, ShieldCheck } from 'lucide-react';

/** Capability-first row — certs stay quiet, not the lead. */
const claims = [
  { icon: Cog, label: '5-axis CNC milling' },
  { icon: Layers, label: 'Aerospace metals & engineering plastics' },
  { icon: Workflow, label: 'Prototype → production in one shop' },
  { icon: ShieldCheck, label: 'Documentation when programs need it' },
];
---
<section class="border-b border-aluminum/40 bg-porcelain py-10 md:py-12" aria-label="Trust signals">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <p class="mb-7 text-center text-[11px] font-bold uppercase tracking-[0.22em] text-aluminum md:mb-8">
      Built for mission-critical programs
    </p>
    <ul class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4 lg:gap-4">
      {claims.map((claim) => (
        <li class="flex min-h-11 items-center gap-3 rounded-xl border border-aluminum/35 bg-porcelain px-4 py-3.5 shadow-[0_8px_24px_rgba(69,63,58,0.06)]">
          <claim.icon size={18} strokeWidth={1.75} className="shrink-0 text-carbon" aria-hidden="true" />
          <span class="text-sm font-semibold tracking-tight text-carbon">
            {claim.label}
          </span>
        </li>
      ))}
    </ul>
  </div>
</section>
