---
import { ShieldCheck, Clock, Layers, FileCheck } from 'lucide-react';

const claims = [
  { icon: ShieldCheck, label: 'AS9100 processes' },
  { icon: Layers, label: 'Aerospace metals & engineering plastics' },
  { icon: Clock, label: 'Quotes in 24h' },
  { icon: FileCheck, label: 'ITAR-ready workflow' },
];
---
<section class="border-b border-zinc-900/60 bg-zinc-950 py-10 md:py-12" aria-label="Trust signals">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <p class="mb-7 text-center text-[11px] font-bold uppercase tracking-[0.22em] text-zinc-500 md:mb-8">
      Built for mission-critical programs
    </p>
    <ul class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4 lg:gap-4">
      {claims.map((claim) => (
        <li class="flex min-h-11 items-center gap-3 rounded-2xl bg-zinc-900/40 px-4 py-3.5 shadow-[0_12px_36px_rgba(0,0,0,0.25)]">
          <claim.icon size={18} strokeWidth={1.75} className="shrink-0 text-zinc-300" aria-hidden="true" />
          <span class="text-sm font-semibold tracking-tight text-zinc-200">
            {claim.label}
          </span>
        </li>
      ))}
    </ul>
  </div>
</section>
