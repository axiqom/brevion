---
import { withBase } from '../../lib/base';

const steps = [
  'Upload CAD',
  'Review',
  'Quote',
  'Manufacture',
  'Inspect',
  'Deliver',
];
---
<section id="process" class="scroll-mt-28 border-t border-aluminum/40 bg-porcelain py-28 md:py-36">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mb-14 md:mb-20">
      <h2 class="text-3xl font-bold uppercase tracking-tight text-carbon md:text-4xl lg:text-5xl">
        Process
      </h2>
    </div>

    <ol class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-6 lg:gap-4">
      {steps.map((step, idx) => (
        <li class="relative overflow-hidden rounded-xl border border-aluminum/30 bg-aluminum/10 px-5 py-6 md:rounded-2xl md:px-6 md:py-8">
          <span class="mb-5 block font-display text-2xl font-bold tabular-nums tracking-tight text-aluminum md:text-3xl">
            {String(idx + 1).padStart(2, '0')}
          </span>
          <span class="block text-base font-semibold uppercase tracking-wide text-carbon md:text-lg">
            {step}
          </span>
          {idx !== steps.length - 1 && (
            <span class="absolute right-4 top-6 hidden text-aluminum lg:block" aria-hidden="true">→</span>
          )}
        </li>
      ))}
    </ol>

    <div class="mt-12 md:mt-16">
      <a
        href={withBase('rfq')}
        class="inline-flex min-h-11 items-center text-sm font-semibold uppercase tracking-widest text-carbon transition-colors duration-150 hover:text-gold"
      >
        Start with CAD →
      </a>
    </div>
  </div>
</section>
