---
import { withBase } from '../../lib/base';
import ProcessStages from '../ProcessStages';
---
<section id="process" class="scroll-mt-28 border-t border-aluminum/35 bg-porcelain py-28 md:py-40">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mb-16 md:mb-24">
      <p class="mb-5 text-[11px] font-semibold uppercase tracking-[0.28em] text-aluminum">
        Process
      </p>
      <h2 class="text-3xl font-bold uppercase tracking-tight text-carbon md:text-4xl lg:text-5xl">
        From CAD to delivery
      </h2>
      <p class="mt-5 max-w-lg text-base font-medium leading-relaxed text-carbon/60 md:text-lg">
        Six stages. Select one for the short fact.
      </p>
    </div>

    <ProcessStages client:load />

    <div class="mt-14 md:mt-16">
      <a
        href={withBase('rfq')}
        class="inline-flex min-h-11 items-center text-sm font-semibold uppercase tracking-widest text-carbon transition-colors duration-150 hover:text-gold"
      >
        Start with CAD →
      </a>
    </div>
  </div>
</section>
