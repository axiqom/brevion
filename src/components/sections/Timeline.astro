---
const steps = [
  'Upload CAD',
  'Review',
  'Quote',
  'Manufacture',
  'Inspect',
  'Deliver',
];
---
<section id="process" class="scroll-mt-28 border-t border-aluminum/40 bg-aluminum/10 py-28 md:py-36">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <h2 class="mb-14 text-3xl font-bold uppercase tracking-tight text-carbon md:mb-20 md:text-4xl lg:text-5xl">
      Process
    </h2>

    <ol class="flex flex-col gap-0 md:flex-row md:flex-wrap md:items-baseline md:gap-x-3 md:gap-y-6">
      {steps.map((step, idx) => (
        <li class="flex items-baseline gap-3 border-t border-aluminum/40 py-5 md:border-t-0 md:py-0">
          <span class="text-base font-medium text-carbon md:text-lg">{step}</span>
          {idx !== steps.length - 1 && (
            <span class="hidden text-aluminum md:inline" aria-hidden="true">→</span>
          )}
        </li>
      ))}
    </ol>
  </div>
</section>
