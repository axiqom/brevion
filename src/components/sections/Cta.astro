---
import { withBase } from '../../lib/base';
---
<section id="cta" class="scroll-mt-28 relative overflow-hidden border-t border-aluminum/40 bg-carbon py-32 md:py-44">
  <div class="absolute inset-0">
    <img
      src={withBase('media/bg-cta.jpg')}
      alt=""
      class="h-full w-full object-cover opacity-40"
      aria-hidden="true"
      loading="lazy"
      decoding="async"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-carbon via-carbon/80 to-carbon/55" aria-hidden="true" />
  </div>
  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl">
      <h2 class="mb-10 text-4xl font-bold uppercase tracking-tight text-porcelain sm:text-5xl md:mb-12 md:text-6xl lg:text-7xl">
        Ready to Start?
      </h2>
      <a
        href={withBase('rfq')}
        class="inline-flex min-h-11 items-center justify-center rounded-lg bg-porcelain px-8 py-4 text-sm font-semibold uppercase tracking-widest text-carbon transition-colors duration-150 hover:bg-gold"
      >
        Request a Quote
      </a>
    </div>
  </div>
</section>
