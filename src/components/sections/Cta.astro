---
import { withBase } from '../../lib/base';
---
<section id="cta" class="scroll-mt-28 border-t border-aluminum/40 bg-porcelain py-28 md:py-40">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="mb-10 text-3xl font-bold uppercase tracking-tight text-carbon sm:text-4xl md:mb-12 md:text-5xl">
        Ready to Start?
      </h2>
      <a
        href={withBase('rfq')}
        class="inline-flex min-h-11 items-center justify-center rounded-lg bg-carbon px-8 py-4 text-sm font-semibold uppercase tracking-widest text-porcelain transition-colors duration-150 hover:bg-gold hover:text-carbon"
      >
        Request a Quote
      </a>
    </div>
  </div>
</section>
