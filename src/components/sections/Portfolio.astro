---
import { withBase } from '../../lib/base';

const projects = [
  {
    title: 'Titanium bracket',
    material: 'Titanium',
    focus: 'Structural fit',
    img: withBase('media/port-01.jpg'),
    alt: 'Precision-machined titanium bracket on a dark surface',
  },
  {
    title: 'Sensor housing',
    material: 'Aluminum',
    focus: 'Interior finish',
    img: withBase('media/port-02.jpg'),
    alt: 'Machined aluminum optical sensor housing with fine surface finish',
  },
];
---
<section id="projects" class="scroll-mt-28 border-t border-aluminum/40 bg-porcelain py-28 md:py-36">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mb-14 flex flex-col justify-between gap-5 md:mb-20 md:flex-row md:items-end">
      <div class="max-w-2xl">
        <h2 class="mb-4 text-3xl font-bold uppercase tracking-tight text-carbon md:text-4xl lg:text-5xl">
          Sample work
        </h2>
        <p class="text-base text-carbon/65 md:text-lg">
          Representative jobs — material and focus.
        </p>
      </div>
      <a
        href={withBase('work')}
        class="inline-flex min-h-11 items-center text-sm font-semibold uppercase tracking-widest text-carbon transition-colors duration-150 hover:text-gold"
      >
        View work →
      </a>
    </div>

    <div class="space-y-20 md:space-y-24">
      {projects.map((proj, idx) => (
        <div class={`flex flex-col items-stretch gap-10 lg:gap-14 ${idx % 2 !== 0 ? 'lg:flex-row-reverse' : 'lg:flex-row'}`}>
          <figure class="group relative aspect-[5/4] w-full overflow-hidden rounded-xl bg-carbon md:rounded-2xl lg:w-1/2">
            <img
              src={proj.img}
              alt={proj.alt}
              class="absolute inset-0 h-full w-full object-cover opacity-80 transition-transform duration-700 motion-reduce:transition-none group-hover:scale-[1.03]"
              loading="lazy"
              decoding="async"
            />
            <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-carbon/40 to-transparent" aria-hidden="true" />
          </figure>

          <div class="flex w-full flex-col justify-center lg:w-1/2">
            <h3 class="mb-10 text-2xl font-bold uppercase leading-tight tracking-tight text-carbon md:text-3xl lg:text-4xl">
              {proj.title}
            </h3>
            <div class="flex gap-12 border-t border-aluminum/40 pt-8">
              <div>
                <span class="mb-2 block text-[11px] font-semibold uppercase tracking-widest text-aluminum">Material</span>
                <span class="text-lg font-semibold text-carbon md:text-xl">{proj.material}</span>
              </div>
              <div>
                <span class="mb-2 block text-[11px] font-semibold uppercase tracking-widest text-aluminum">Focus</span>
                <span class="text-lg font-semibold text-carbon md:text-xl">{proj.focus}</span>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
