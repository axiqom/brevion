---
import { ArrowRight } from 'lucide-react';

const projects = [
  {
    title: 'Titanium Aerospace Bracket',
    industry: 'Aerospace',
    material: 'Ti-6Al-4V',
    tolerance: '±0.0005"',
    challenge: 'Reduce weight while maintaining structural strength under extreme dynamic loads.',
    solution: 'Optimized 5-axis machining strategy to hollow out non-critical sections and tight tolerance control on mating surfaces.',
    img: 'https://images.unsplash.com/photo-1611078810237-67c46927cc1a?q=80&w=1200&auto=format&fit=crop',
  },
  {
    title: 'Optical Sensor Housing',
    industry: 'Defense',
    material: 'Aluminum 7075-T6',
    tolerance: '±0.0002"',
    challenge: 'Complex internal geometry with critical surface finish requirements for optics alignment.',
    solution: 'Custom tooling development and multi-stage precision boring operations.',
    img: 'https://images.unsplash.com/photo-1504917595217-d4dc5ebe6122?q=80&w=1200&auto=format&fit=crop',
  },
];
---
<section id="projects" class="scroll-mt-28 border-t border-zinc-800 bg-zinc-900 py-24 md:py-32">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mb-16 flex flex-col justify-between gap-6 md:mb-24 md:flex-row md:items-end md:gap-8">
      <div class="max-w-2xl">
        <h2 class="mb-6 text-4xl font-bold uppercase tracking-tight text-white md:text-5xl lg:text-6xl">
          Featured Work
        </h2>
        <p class="text-lg text-zinc-400 md:text-xl">
          A look at some of the mission-critical components we've manufactured for industry leaders.
        </p>
      </div>
      <a
        href="/rfq"
        class="hidden items-center gap-2 text-sm font-bold uppercase tracking-widest text-white transition-colors hover:text-zinc-400 md:flex"
      >
        View All Projects <ArrowRight size={18} aria-hidden="true" />
      </a>
    </div>

    <div class="space-y-20 md:space-y-28 lg:space-y-32">
      {projects.map((proj, idx) => (
        <div class={`flex flex-col items-center gap-10 lg:gap-20 ${idx % 2 !== 0 ? 'lg:flex-row-reverse' : 'lg:flex-row'}`}>
          <div class="group relative aspect-[4/3] w-full overflow-hidden rounded-[2rem] border border-zinc-800 bg-zinc-950 md:rounded-[2.5rem] lg:w-1/2">
            <img
              src={proj.img}
              alt={proj.title}
              class="absolute inset-0 h-full w-full object-cover opacity-60 mix-blend-luminosity transition-transform duration-700 group-hover:scale-105 group-hover:opacity-80"
              data-placeholder="portfolio"
            />
            <div class="absolute inset-0 bg-zinc-950/20 transition-colors duration-500 group-hover:bg-transparent" />
            <span class="placeholder-caption">Placeholder</span>
          </div>

          <div class="flex w-full flex-col justify-center lg:w-1/2">
            <div class="mb-6 inline-flex items-center gap-2 self-start rounded-full border border-zinc-700 bg-zinc-800 px-4 py-2 text-xs font-bold uppercase tracking-[0.2em] text-white md:mb-8">
              {proj.industry}
            </div>
            <h3 class="mb-8 text-3xl font-bold uppercase leading-tight tracking-tight text-white md:mb-10 md:text-4xl lg:text-5xl">
              {proj.title}
            </h3>

            <div class="mb-10 flex gap-10 border-b border-zinc-800 pb-10 md:mb-12 md:gap-12 md:pb-12">
              <div>
                <span class="mb-2 block text-sm font-bold uppercase tracking-widest text-zinc-500">Material</span>
                <span class="text-lg font-bold text-white md:text-xl">{proj.material}</span>
              </div>
              <div>
                <span class="mb-2 block text-sm font-bold uppercase tracking-widest text-zinc-500">Tolerance</span>
                <span class="text-lg font-bold text-white md:text-xl">{proj.tolerance}</span>
              </div>
            </div>

            <div class="space-y-8 md:space-y-10">
              <div>
                <h4 class="mb-3 text-sm font-bold uppercase tracking-[0.2em] text-zinc-500 md:mb-4">The Challenge</h4>
                <p class="text-base font-medium leading-relaxed text-zinc-400 md:text-lg">{proj.challenge}</p>
              </div>
              <div>
                <h4 class="mb-3 text-sm font-bold uppercase tracking-[0.2em] text-zinc-500 md:mb-4">Our Solution</h4>
                <p class="text-base font-medium leading-relaxed text-zinc-400 md:text-lg">{proj.solution}</p>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>

    <a
      href="/rfq"
      class="mt-16 flex w-full items-center justify-center gap-2 rounded-full bg-white py-5 text-sm font-bold uppercase tracking-widest text-zinc-950 transition-colors hover:bg-zinc-200 md:hidden"
    >
      View All Projects <ArrowRight size={18} aria-hidden="true" />
    </a>
  </div>
</section>
