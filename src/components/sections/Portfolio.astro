---
import { ArrowRight } from 'lucide-react';

const projects = [
  {
    title: 'Titanium Aerospace Bracket',
    industry: 'Aerospace',
    material: 'Ti-6Al-4V',
    tolerance: '±0.0005"',
    challenge: 'Reduce weight while holding structural strength under dynamic loads.',
    solution: '5-axis strategy to lighten non-critical sections; tight control on mating faces.',
    img: 'https://images.unsplash.com/photo-1611078810237-67c46927cc1a?q=80&w=1200&auto=format&fit=crop',
    caption: 'Sample case · Ti bracket',
  },
  {
    title: 'Optical Sensor Housing',
    industry: 'Defense',
    material: 'Aluminum 7075-T6',
    tolerance: '±0.0002"',
    challenge: 'Complex internals with surface finish critical to optics alignment.',
    solution: 'Custom tooling and multi-stage precision boring against print.',
    img: 'https://images.unsplash.com/photo-1504917595217-d4dc5ebe6122?q=80&w=1200&auto=format&fit=crop',
    caption: 'Sample case · sensor housing',
  },
];
---
<section id="projects" class="scroll-mt-28 border-t border-zinc-800 bg-zinc-900 py-20 md:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mb-12 flex flex-col justify-between gap-4 md:mb-14 md:flex-row md:items-end">
      <div class="max-w-2xl">
        <p class="mb-3 text-[11px] font-bold uppercase tracking-[0.22em] text-zinc-500">
          Portfolio
        </p>
        <h2 class="mb-3 text-3xl font-bold uppercase tracking-tight text-white md:text-4xl lg:text-5xl">
          Sample work
        </h2>
        <p class="text-base text-zinc-400 md:text-lg">
          Representative jobs — material, tolerance, and approach. Placeholder imagery until cleared photos ship.
        </p>
      </div>
      <a
        href="#intake"
        class="inline-flex min-h-11 items-center gap-2 text-sm font-bold uppercase tracking-widest text-white transition-colors hover:text-zinc-400"
      >
        Request quote <ArrowRight size={18} aria-hidden="true" />
      </a>
    </div>

    <div class="space-y-16 md:space-y-20">
      {projects.map((proj, idx) => (
        <div class={`flex flex-col items-stretch gap-8 lg:gap-14 ${idx % 2 !== 0 ? 'lg:flex-row-reverse' : 'lg:flex-row'}`}>
          <figure class="relative aspect-[5/4] w-full overflow-hidden rounded-2xl border border-zinc-800 bg-zinc-950 md:rounded-3xl lg:w-1/2">
            <img
              src={proj.img}
              alt=""
              class="absolute inset-0 h-full w-full object-cover opacity-55 mix-blend-luminosity"
              data-placeholder="portfolio"
            />
            <figcaption class="placeholder-caption">{proj.caption}</figcaption>
          </figure>

          <div class="flex w-full flex-col justify-center lg:w-1/2">
            <p class="mb-3 text-[11px] font-bold uppercase tracking-[0.2em] text-zinc-500">
              {proj.industry}
            </p>
            <h3 class="mb-6 text-2xl font-bold uppercase leading-tight tracking-tight text-white md:mb-8 md:text-3xl lg:text-4xl">
              {proj.title}
            </h3>

            <div class="mb-8 flex gap-8 border-b border-zinc-800 pb-8 md:gap-10">
              <div>
                <span class="mb-1.5 block text-xs font-bold uppercase tracking-widest text-zinc-500">Material</span>
                <span class="text-base font-bold text-white md:text-lg">{proj.material}</span>
              </div>
              <div>
                <span class="mb-1.5 block text-xs font-bold uppercase tracking-widest text-zinc-500">Tolerance</span>
                <span class="text-base font-bold text-white md:text-lg">{proj.tolerance}</span>
              </div>
            </div>

            <div class="space-y-6">
              <div>
                <h4 class="mb-2 text-xs font-bold uppercase tracking-[0.2em] text-zinc-500">Challenge</h4>
                <p class="text-sm font-medium leading-relaxed text-zinc-400 md:text-base">{proj.challenge}</p>
              </div>
              <div>
                <h4 class="mb-2 text-xs font-bold uppercase tracking-[0.2em] text-zinc-500">Approach</h4>
                <p class="text-sm font-medium leading-relaxed text-zinc-400 md:text-base">{proj.solution}</p>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
