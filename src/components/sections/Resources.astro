---
import { ArrowUpRight } from 'lucide-react';

const links = [
  { label: 'DFM for 5-axis CNC', href: '#' },
  { label: 'Titanium grades quick ref', href: '#' },
  { label: 'GD&T & surface finish', href: '#' },
];
---
<section id="resources" class="scroll-mt-28 border-t border-aluminum/40 bg-porcelain py-10 md:py-12">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
      <div>
        <h2 class="mb-1 text-xl font-bold uppercase tracking-tight text-carbon md:text-2xl">
          Engineering notes
        </h2>
        <p class="text-sm font-medium text-aluminum">
          Short references for print review and material selection.
        </p>
      </div>
      <ul class="flex flex-col gap-2 sm:flex-row sm:flex-wrap sm:gap-3">
        {links.map((link) => (
          <li>
            <a
              href={link.href}
              class="inline-flex min-h-11 items-center gap-2 rounded-lg border border-aluminum/40 bg-porcelain px-4 py-2.5 text-xs font-semibold uppercase tracking-widest text-carbon transition-colors duration-150 hover:border-gold hover:text-gold"
            >
              {link.label}
              <ArrowUpRight size={14} aria-hidden="true" />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
