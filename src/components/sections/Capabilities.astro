---
import { withBase } from '../../lib/base';

const capabilities = [
  {
    num: '01',
    title: 'CNC Milling',
    slug: 'milling',
    line: 'High-precision machining for complex components.',
    img: withBase('media/cap-manufacturing.jpg'),
    alt: 'CNC machining center cutting a precision metal part',
  },
  {
    num: '02',
    title: 'CNC Turning',
    slug: 'turning',
    line: 'Production-ready turned components.',
    img: withBase('media/cap-finishing.jpg'),
    alt: 'Finished precision turned and machined parts',
  },
  {
    num: '03',
    title: 'Prototype Manufacturing',
    slug: 'prototype',
    line: 'CAD to first articles.',
    img: withBase('media/cap-engineering.jpg'),
    alt: 'Engineer reviewing CAD model and toolpaths on a workstation',
  },
  {
    num: '04',
    title: 'Inspection',
    slug: 'inspection',
    line: 'Inspection throughout every stage of manufacturing.',
    img: withBase('media/cap-quality.jpg'),
    alt: 'Coordinate measuring machine inspecting a machined component',
  },
];
---
<section id="capabilities" class="scroll-mt-28 border-t border-aluminum/40 bg-aluminum/10 py-28 md:py-36">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mb-14 flex flex-col justify-between gap-6 md:mb-20 md:flex-row md:items-end">
      <h2 class="max-w-xl text-3xl font-bold uppercase tracking-tight text-carbon md:text-4xl lg:text-5xl">
        Capabilities
      </h2>
      <a
        href={withBase('capabilities')}
        class="inline-flex min-h-11 items-center text-sm font-semibold uppercase tracking-widest text-carbon transition-colors duration-150 hover:text-gold"
      >
        Full capabilities →
      </a>
    </div>

    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:gap-6">
      {capabilities.map((cap) => (
        <a
          href={withBase('capabilities')}
          class="group relative flex min-h-[280px] flex-col overflow-hidden rounded-xl bg-carbon outline-none transition-transform duration-300 hover:-translate-y-0.5 focus-visible:ring-2 focus-visible:ring-gold focus-visible:ring-offset-2 focus-visible:ring-offset-porcelain motion-reduce:transition-none motion-reduce:hover:translate-y-0 sm:min-h-[320px] md:rounded-2xl lg:min-h-[360px]"
        >
          <img
            src={cap.img}
            alt={cap.alt}
            class="absolute inset-0 h-full w-full object-cover opacity-75 transition-[transform,opacity] duration-700 motion-reduce:transition-none group-hover:scale-[1.04] group-hover:opacity-90"
            loading="lazy"
            decoding="async"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-carbon/95 via-carbon/40 to-carbon/10" />
          <div class="relative z-10 mt-auto flex flex-col p-6 sm:p-8 md:p-10">
            <span class="mb-4 font-display text-2xl font-bold tabular-nums tracking-tight text-porcelain/50 md:text-3xl">
              {cap.num}
            </span>
            <h3 class="mb-2 text-xl font-bold uppercase tracking-tight text-porcelain md:text-2xl">
              {cap.title}
            </h3>
            <p class="max-w-sm text-sm font-medium leading-relaxed text-porcelain/70 md:text-base">
              {cap.line}
            </p>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
