---
const capabilities = [
  {
    num: '01',
    title: 'Engineering',
    metrics: ['DFM before cut', 'CAD → CAM'],
    items: ['CAD / reverse engineering', 'DFM analysis', 'CAM programming'],
    select: 'Need design help or manufacturability review first.',
    img: 'https://images.unsplash.com/photo-1581092334651-ddf26d9a09d0?q=80&w=1200&auto=format&fit=crop',
    caption: 'Engineering / CAM',
  },
  {
    num: '02',
    title: 'Manufacturing',
    metrics: ['3 / 4 / 5-axis', '2–3 wk prototypes'],
    items: ['Mill: 3-, 4-, 5-axis CNC', 'Turn: CNC turning', 'Prototype → production'],
    select: 'Self-select mill vs turn, proto vs volume.',
    img: 'https://images.unsplash.com/photo-1565439390119-c4dbafddb4eb?q=80&w=1200&auto=format&fit=crop',
    caption: 'CNC machining',
  },
  {
    num: '03',
    title: 'Quality',
    metrics: ['±0.0001"', 'AS9102 FAI'],
    items: ['CMM inspection', 'AS9102 FAI when required', 'Full material traceability'],
    select: 'For prints that demand documented first article.',
    img: 'https://images.unsplash.com/photo-1581092580497-e0d23cbdf1dc?q=80&w=1200&auto=format&fit=crop',
    caption: 'Metrology',
  },
  {
    num: '04',
    title: 'Finishing',
    metrics: ['Type II / III anodize', 'One handoff'],
    items: ['Anodize Type II & III', 'Powder coat / heat treat', 'Laser engrave + hardware'],
    select: 'Machining and finishing coordinated — no vendor hop.',
    img: 'https://images.unsplash.com/photo-1504917595217-d4dc5ebe6122?q=80&w=1200&auto=format&fit=crop',
    caption: 'Finishing',
  },
];
---
<section id="capabilities" class="scroll-mt-28 border-t border-zinc-900 bg-zinc-950 py-20 md:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mb-12 max-w-2xl md:mb-14">
      <p class="mb-3 text-[11px] font-bold uppercase tracking-[0.22em] text-zinc-500">
        Capabilities
      </p>
      <h2 class="mb-4 text-3xl font-bold uppercase tracking-tight text-white md:text-4xl lg:text-5xl">
        Four desks. Concrete numbers.
      </h2>
      <p class="text-base text-zinc-400 md:text-lg">
        Engineering, multi-axis machining, inspection, and finishing — pick the lane that matches your print.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4 lg:gap-5">
      {capabilities.map((group) => (
        <article class="group flex flex-col overflow-hidden rounded-2xl border border-zinc-800 bg-zinc-900/50 md:rounded-3xl">
          <div class="relative aspect-[16/10] overflow-hidden border-b border-zinc-800 bg-zinc-950">
            <img
              src={group.img}
              alt=""
              class="absolute inset-0 h-full w-full object-cover opacity-45 mix-blend-luminosity transition-transform duration-700 motion-reduce:transition-none group-hover:scale-[1.03]"
              data-placeholder="capability"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-zinc-950/80 to-transparent" />
            <span class="placeholder-caption">{group.caption} · Placeholder</span>
            <span class="absolute left-4 top-4 font-display text-2xl font-bold tabular-nums tracking-tight text-white/90 md:text-3xl">
              {group.num}
            </span>
          </div>
          <div class="flex flex-1 flex-col p-5 sm:p-6 md:p-7">
            <h3 class="mb-3 text-xl font-bold uppercase tracking-tight text-white md:text-2xl">
              {group.title}
            </h3>
            <div class="mb-4 flex flex-wrap gap-2">
              {group.metrics.map((m) => (
                <span class="inline-flex min-h-9 items-center rounded-full border border-zinc-700 bg-zinc-950/60 px-3 py-1 text-[11px] font-bold uppercase tracking-wider text-zinc-200">
                  {m}
                </span>
              ))}
            </div>
            <ul class="mb-4 space-y-2.5">
              {group.items.map((item) => (
                <li class="flex items-start gap-2.5 text-sm font-medium text-zinc-400">
                  <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-zinc-500" aria-hidden="true" />
                  {item}
                </li>
              ))}
            </ul>
            <p class="mt-auto border-t border-zinc-800 pt-4 text-xs font-medium leading-relaxed text-zinc-500">
              {group.select}
            </p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
