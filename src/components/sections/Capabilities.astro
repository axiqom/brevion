---
import { withBase } from '../../lib/base';
import ExpandableCardGrid from '../ExpandableCard';

const capabilities = [
  {
    id: 'milling',
    num: '01',
    title: 'CNC Milling',
    line: 'Brevion offers multi-axis CNC milling for complex geometry in metals and engineering plastics.',
    img: withBase('media/cap-manufacturing.jpg'),
    alt: '5-axis CNC machining center with open enclosure and control console',
    facts: [
      '3-, 4-, and 5-axis milling.',
      'Metals and engineering plastics.',
      'Prototype through production lots.',
    ],
    rfqSlug: 'milling',
  },
  {
    id: 'turning',
    num: '02',
    title: 'CNC Turning',
    line: 'Brevion turns diameters and features on common metals and bar stock, ready for production.',
    img: withBase('media/cap-turning.jpg'),
    alt: 'CNC lathe chuck holding a turned metal workpiece with turret tooling',
    facts: [
      'Lathe work for diameters and features.',
      'Common metals and bar stock.',
      'Fits milling when parts need both.',
    ],
    rfqSlug: 'turning',
  },
  {
    id: 'prototype',
    num: '03',
    title: 'Prototype Manufacturing',
    line: 'Brevion builds low-volume first articles from CAD with design review before cut.',
    img: withBase('media/cap-engineering.jpg'),
    alt: 'Vertical machining center used for prototype and first-article work',
    facts: [
      'Low volume first articles from CAD.',
      'Design review before cut.',
      'Path to production when the design locks.',
    ],
    rfqSlug: 'prototype',
  },
  {
    id: 'inspection',
    num: '04',
    title: 'Inspection',
    line: 'Brevion inspects parts in-process and at final with CMM and standard metrology tools.',
    img: withBase('media/cap-quality.jpg'),
    alt: 'Coordinate measuring machine probe over a granite surface plate',
    facts: [
      'In-process and final dimensional checks.',
      'CMM and standard metrology tools.',
      'Documentation when the print requires it.',
    ],
    rfqSlug: 'inspection',
  },
];
---
<section id="capabilities" class="scroll-mt-28 border-t border-aluminum/35 bg-aluminum/10 py-20 sm:py-28 md:py-40">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mb-10 flex flex-col justify-between gap-5 sm:mb-16 sm:gap-6 md:mb-24 md:flex-row md:items-end">
      <div class="max-w-xl">
        <p class="mb-4 text-[11px] font-semibold uppercase tracking-[0.28em] text-aluminum sm:mb-5">
          Capabilities
        </p>
        <h2 class="text-2xl font-bold uppercase tracking-tight text-carbon sm:text-3xl md:text-4xl lg:text-5xl">
          What we machine
        </h2>
        <p class="mt-4 max-w-md text-base font-medium leading-relaxed text-carbon/60 sm:mt-5 md:text-lg">
          Brevion mills, turns, prototypes, and inspects parts for engineers who need a reliable CNC partner. Select a capability for detail and a quote path.
        </p>
      </div>
      <a
        href={withBase('capabilities')}
        class="inline-flex min-h-11 items-center text-sm font-semibold uppercase tracking-widest text-carbon transition-colors duration-150 hover:text-gold"
      >
        Full capabilities →
      </a>
    </div>

    <ExpandableCardGrid client:load items={capabilities} />
  </div>
</section>
