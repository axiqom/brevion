---
import { withBase } from '../../lib/base';

const capabilities = [
  {
    num: '01',
    title: 'CNC Milling',
    slug: 'milling',
    line: 'Multi-axis milling for complex geometry.',
    img: withBase('media/cap-manufacturing.jpg'),
    alt: '5-axis CNC machining center with open enclosure and control console',
  },
  {
    num: '02',
    title: 'CNC Turning',
    slug: 'turning',
    line: 'Turned components ready for production.',
    img: withBase('media/cap-turning.jpg'),
    alt: 'CNC lathe chuck holding a turned metal workpiece with turret tooling',
  },
  {
    num: '03',
    title: 'Prototype Manufacturing',
    slug: 'prototype',
    line: 'CAD to first articles.',
    img: withBase('media/cap-engineering.jpg'),
    alt: 'Vertical machining center used for prototype and first-article work',
  },
  {
    num: '04',
    title: 'Inspection',
    slug: 'inspection',
    line: 'Inspection throughout every stage of manufacturing.',
    img: withBase('media/cap-quality.jpg'),
    alt: 'Coordinate measuring machine probe over a granite surface plate',
  },
];
---
<section id="capabilities" class="scroll-mt-28 border-t border-aluminum/35 bg-aluminum/10 py-28 md:py-40">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mb-16 flex flex-col justify-between gap-6 md:mb-24 md:flex-row md:items-end">
      <div class="max-w-xl">
        <p class="mb-5 text-[11px] font-semibold uppercase tracking-[0.28em] text-aluminum">
          Capabilities
        </p>
        <h2 class="text-3xl font-bold uppercase tracking-tight text-carbon md:text-4xl lg:text-5xl">
          What we machine
        </h2>
      </div>
      <a
        href={withBase('capabilities')}
        class="inline-flex min-h-11 items-center text-sm font-semibold uppercase tracking-widest text-carbon transition-colors duration-150 hover:text-gold"
      >
        Full capabilities →
      </a>
    </div>

    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:gap-6">
      {capabilities.map((cap) => (
        <a
          href={withBase('capabilities')}
          class="group relative flex min-h-[300px] flex-col overflow-hidden rounded-xl bg-carbon outline-none transition-transform duration-300 hover:-translate-y-0.5 focus-visible:ring-2 focus-visible:ring-gold focus-visible:ring-offset-2 focus-visible:ring-offset-porcelain motion-reduce:transition-none motion-reduce:hover:translate-y-0 sm:min-h-[340px] md:rounded-2xl lg:min-h-[380px]"
        >
          <img
            src={cap.img}
            alt={cap.alt}
            class="absolute inset-0 h-full w-full object-cover opacity-80 transition-[transform,opacity] duration-700 motion-reduce:transition-none group-hover:scale-[1.04] group-hover:opacity-90"
            loading="lazy"
            decoding="async"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-carbon/95 via-carbon/45 to-carbon/10" />
          <div class="relative z-10 mt-auto flex flex-col p-7 sm:p-8 md:p-10">
            <span class="mb-5 font-display text-2xl font-bold tabular-nums tracking-tight text-porcelain/45 md:text-3xl">
              {cap.num}
            </span>
            <h3 class="mb-2 text-xl font-bold uppercase tracking-tight text-porcelain md:text-2xl">
              {cap.title}
            </h3>
            <p class="max-w-sm text-sm font-medium leading-relaxed text-porcelain/65 md:text-base">
              {cap.line}
            </p>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
