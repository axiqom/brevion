---
import { ArrowRight } from 'lucide-react';
import { withBase } from '../../lib/base';
import { CONTACT_EMAIL, CONTACT_MAILTO } from '../../lib/site';

interface Props {
  line?: string;
}

const {
  line = 'Send the STEP + drawing — start a quote or email sales@brevion.com.',
} = Astro.props;
---
<section class="border-y border-aluminum/30 bg-aluminum/10 py-8 sm:py-10 md:py-12" aria-label="Request a quote">
  <div class="mx-auto flex max-w-7xl flex-col items-stretch justify-between gap-5 px-4 sm:gap-6 sm:px-6 md:flex-row md:items-center lg:px-8">
    <p class="max-w-xl text-base font-medium leading-relaxed text-carbon/75 md:text-lg">
      {line}
    </p>
    <div class="flex w-full flex-col gap-3 sm:w-auto sm:flex-row sm:items-center">
      <a
        href={withBase('rfq')}
        class="inline-flex min-h-12 items-center justify-center gap-2 rounded-lg bg-carbon px-6 py-3 text-xs font-semibold uppercase tracking-widest text-porcelain transition-colors duration-150 hover:bg-gold hover:text-carbon sm:min-h-11 sm:text-sm"
      >
        Request a Quote
        <ArrowRight size={16} aria-hidden="true" />
      </a>
      <a
        href={CONTACT_MAILTO}
        class="inline-flex min-h-12 items-center justify-center rounded-lg border border-carbon bg-porcelain px-6 py-3 text-xs font-semibold uppercase tracking-widest text-carbon transition-colors duration-150 hover:border-gold hover:text-gold sm:min-h-11 sm:text-sm"
      >
        Email {CONTACT_EMAIL}
      </a>
    </div>
  </div>
</section>
