---
/**
 * Team strip — photography removed (no matching portraits).
 * Typography-only porcelain band; unused on home but kept for future.
 */
---
<section id="team" class="scroll-mt-28 border-t border-aluminum/35 bg-porcelain py-20 md:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <p class="mb-5 text-[11px] font-semibold uppercase tracking-[0.28em] text-aluminum">
      Team
    </p>
    <h2 class="max-w-xl text-3xl font-bold uppercase tracking-tight text-carbon md:text-4xl">
      Engineers and machinists
    </h2>
  </div>
</section>
