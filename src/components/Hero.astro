---
import { withBase } from '../lib/base';
---
<section class="relative flex min-h-[100svh] items-stretch overflow-x-hidden overflow-y-visible bg-carbon">
  <div class="absolute inset-0 overflow-hidden bg-carbon">
    <picture>
      <source media="(min-width: 768px)" srcset={withBase('hero-cnc.jpg')} />
      <img
        src={withBase('hero-cnc-sm.jpg')}
        alt=""
        class="h-full w-full object-cover object-[center_42%] opacity-80"
        aria-hidden="true"
      />
    </picture>
    <div class="absolute inset-0 bg-gradient-to-t from-carbon via-carbon/55 to-carbon/25"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-carbon/90 via-carbon/40 to-transparent"></div>
  </div>

  <div class="relative z-10 mx-auto flex w-full max-w-7xl flex-col justify-end px-4 pb-28 pt-36 sm:px-6 md:justify-center md:pb-40 md:pt-32 lg:px-8">
    <div class="animate-fade-up max-w-4xl opacity-0" style="animation-delay: 0.05s">
      <p class="mb-6 text-[11px] font-semibold uppercase tracking-[0.28em] text-porcelain/55">
        Precision CNC
      </p>
      <h1 class="mb-7 max-w-3xl text-[2.35rem] font-bold uppercase leading-[0.92] tracking-tight text-porcelain sm:mb-8 sm:text-5xl md:text-6xl lg:text-[4.85rem]">
        Advanced Precision Manufacturing
      </h1>
      <p class="mb-12 max-w-xl text-base font-medium tracking-wide text-porcelain/65 sm:mb-14 sm:text-lg md:text-xl">
        CNC Machining for Prototype and Production
      </p>

      <div class="flex flex-col items-stretch gap-3 sm:flex-row sm:items-center sm:gap-4">
        <a
          href={withBase('rfq')}
          class="inline-flex min-h-11 items-center justify-center rounded-lg bg-porcelain px-8 py-4 text-sm font-semibold uppercase tracking-widest text-carbon transition-colors duration-150 hover:bg-gold"
        >
          Request a Quote
        </a>
        <a
          href={withBase('capabilities')}
          class="inline-flex min-h-11 items-center justify-center rounded-lg border border-porcelain/35 px-8 py-4 text-sm font-semibold uppercase tracking-widest text-porcelain transition-colors duration-150 hover:border-gold hover:text-gold"
        >
          View Capabilities
        </a>
      </div>
    </div>
  </div>
</section>
