---
import { ArrowRight, Cuboid } from 'lucide-react';
---
<section class="relative flex min-h-[100svh] items-end overflow-hidden bg-zinc-950">
  <div class="absolute inset-0 overflow-hidden bg-zinc-950" data-placeholder="hero-video">
    <video
      autoplay
      loop
      muted
      playsinline
      poster="https://images.unsplash.com/photo-1565439390119-c4dbafddb4eb?q=80&w=3000&auto=format&fit=crop"
      class="h-full w-full object-cover opacity-45 mix-blend-luminosity"
    >
      <source
        src="https://videos.pexels.com/video-files/3204962/3204962-hd_1920_1080_25fps.mp4"
        type="video/mp4"
      />
    </video>
    <div class="absolute inset-0 bg-gradient-to-t from-zinc-950 via-zinc-950/75 to-zinc-950/35"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-zinc-950/80 via-transparent to-zinc-950/40"></div>
    <span class="placeholder-caption">Placeholder</span>
  </div>

  <div class="relative z-10 mx-auto w-full max-w-7xl px-4 pb-20 pt-28 sm:px-6 md:pb-28 lg:px-8">
    <div class="max-w-4xl animate-fade-up opacity-0" style="animation-delay: 0.05s">
      <div class="mb-8 flex items-center gap-3 md:mb-10">
        <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-white text-zinc-950 md:h-12 md:w-12">
          <Cuboid size={24} aria-hidden="true" />
        </div>
        <p class="font-display text-3xl font-bold uppercase tracking-[0.28em] text-white md:text-4xl">
          AERIS
        </p>
      </div>

      <h1 class="mb-6 max-w-3xl text-4xl font-bold uppercase leading-[0.95] tracking-tight text-white sm:text-5xl md:mb-8 md:text-6xl lg:text-7xl">
        Precision Mission-Critical Manufacturing.
      </h1>
      <p class="mb-10 max-w-2xl text-base font-medium leading-relaxed text-zinc-300 md:mb-12 md:text-lg lg:text-xl">
        From prototype to production, we manufacture precision components for aerospace, defense, robotics, industrial automation, and advanced technology companies.
      </p>
      <div class="flex flex-col gap-4 sm:flex-row">
        <a
          href="/rfq"
          class="group flex items-center justify-center gap-3 rounded-full bg-white px-8 py-4 text-sm font-bold uppercase tracking-widest text-zinc-950 transition-colors hover:bg-zinc-200 md:px-10 md:py-5 md:text-base"
        >
          Request a Quote
          <ArrowRight size={18} className="transition-transform group-hover:translate-x-1" aria-hidden="true" />
        </a>
        <a
          href="#capabilities"
          class="flex items-center justify-center rounded-full border border-zinc-600/60 bg-zinc-950/40 px-8 py-4 text-center text-sm font-bold uppercase tracking-widest text-white backdrop-blur-md transition-all hover:border-zinc-500 hover:bg-zinc-900/70 md:px-10 md:py-5 md:text-base"
        >
          View Capabilities
        </a>
      </div>
    </div>
  </div>
</section>
